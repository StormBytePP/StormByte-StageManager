# Bash completion for StormByte-StageManager
# Install to: /usr/share/bash-completion/completions/StormByte-StageManager

_sbsm_get_config_value() {
	local key="$1"
	local config_file=""

	local script_path
	script_path="$(command -v StormByte-StageManager 2>/dev/null)"
	if [[ -n "$script_path" ]]; then
		local script_dir="${script_path%/*}"
		if [[ -f "${script_dir}/StormByte-StageManager.conf" ]]; then
			config_file="${script_dir}/StormByte-StageManager.conf"
		fi
	fi
	if [[ -z "$config_file" && -f "/etc/conf.d/StormByte-StageManager.conf" ]]; then
		config_file="/etc/conf.d/StormByte-StageManager.conf"
	fi

	[[ -z "$config_file" ]] && return

	local raw
	raw=$(grep -E "^[[:space:]]*${key}=" "$config_file" 2>/dev/null | head -1 | cut -d'=' -f2-)
	raw="${raw#"${raw%%[! ]*}"}"
	raw="${raw%"${raw##*[! ]}"}"
	raw="${raw#[\"\']}"
	raw="${raw%[\"\']}"
	printf '%s' "$raw"
}

_sbsm_tarball_folder() {
	local folder
	folder="$(_sbsm_get_config_value TARBALL_FOLDER)"
	# Allow env override used by the script
	[[ -n "${TARBALL_FOLDER_OVERRIDE:-}" ]] && folder="${TARBALL_FOLDER_OVERRIDE}"
	[[ -n "${TARBALL_FOLDER:-}" ]] && folder="${TARBALL_FOLDER}"
	printf '%s' "$folder"
}

# Space-separated basenames of stages (excludes ccache/sccache sidecars)
_sbsm_stage_names() {
	local tarball_folder
	tarball_folder="$(_sbsm_tarball_folder)"
	[[ -z "$tarball_folder" || ! -d "$tarball_folder" ]] && return

	find "$tarball_folder" -maxdepth 1 -type f \
		-iregex '.*\.\(tar\.gz\|tgz\|tar\.bz2\|tbz2\|tar\.xz\|txz\|tar\.zstd\|tzd\)$' \
		! -name 'ccache.tbz2' ! -name 'sccache.tbz2' \
		-printf '%f\n' 2>/dev/null | sort
}

_sbsm_get_index_count() {
	local names
	names="$(_sbsm_stage_names)"
	[[ -z "$names" ]] && { printf '0'; return; }
	printf '%s\n' "$names" | wc -l
}

_sbsm_index_words() {
	local count i words=""
	count="$(_sbsm_get_index_count)"
	[[ -z "$count" || "$count" -eq 0 ]] && return
	for (( i = 0; i < count; i++ )); do
		words+="$i "
	done
	printf '%s' "$words"
}

# Index and/or stage basename (what use/rebase/… accept)
_sbsm_complete_stage() {
	local idx_words names
	idx_words="$(_sbsm_index_words)"
	mapfile -t names < <(_sbsm_stage_names)
	COMPREPLY=( $(compgen -W "${idx_words} ${names[*]}" -- "$cur") )
}

_StormByte_StageManager() {
	local cur prev words cword
	_init_completion || return

	local commands="list ls use rebase convert export delete rm rename download help notes config"
	local compression_formats="gzip bzip2 xz zstd"
	local arches="i486 i686 amd64 x32"
	local help_topics="list use rebase convert export delete rename download notes config compression"
	local notes_subcommands="edit delete list"

	local profiles_i486="default"
	local profiles_i686="default hardened systemd uclibc-hardened uclibc-vanilla"
	local profiles_amd64="default hardened nomultilib systemd hardened+nomultilib hardened-selinux hardened-selinux+nomultilib uclibc-hardened uclibc-vanilla"
	local profiles_x32="default"

	local cmd="${words[1]}"
	# Normalize aliases for the rest of the logic
	case "$cmd" in
		ls) cmd="list" ;;
		rm) cmd="delete" ;;
	esac

	case "$cword" in
		1)
			COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
			;;
		2)
			case "$cmd" in
				use|rebase|convert|delete|rename|export)
					_sbsm_complete_stage
					;;
				notes)
					# notes list  |  notes <index|filename> …
					local idx_words names
					idx_words="$(_sbsm_index_words)"
					mapfile -t names < <(_sbsm_stage_names)
					COMPREPLY=( $(compgen -W "list ${idx_words} ${names[*]}" -- "$cur") )
					;;
				download)
					COMPREPLY=( $(compgen -W "$arches" -- "$cur") )
					;;
				help)
					COMPREPLY=( $(compgen -W "$help_topics" -- "$cur") )
					;;
			esac
			;;
		3)
			case "$cmd" in
				rebase|rename)
					local tarball_folder
					tarball_folder="$(_sbsm_tarball_folder)"
					if [[ -n "$tarball_folder" && -d "$tarball_folder" ]]; then
						local -a tarballs
						mapfile -t tarballs < <(_sbsm_stage_names)
						COMPREPLY=( $(compgen -W "${tarballs[*]}" -- "$cur") )
					fi
					;;
				convert)
					COMPREPLY=( $(compgen -W "$compression_formats" -- "$cur") )
					;;
				export)
					COMPREPLY=( $(compgen -d -- "$cur") )
					compopt -o nospace 2>/dev/null || true
					;;
				download)
					local arch="${words[2]}"
					local profiles_var="profiles_${arch//-/_}"
					COMPREPLY=( $(compgen -W "${!profiles_var}" -- "$cur") )
					;;
				notes)
					# notes <stage> edit|delete  (notes list has no further args)
					if [[ "${words[2]}" != "list" ]]; then
						COMPREPLY=( $(compgen -W "edit delete" -- "$cur") )
					fi
					;;
			esac
			;;
		4)
			case "$cmd" in
				export)
					COMPREPLY=( $(compgen -W "$compression_formats" -- "$cur") )
					;;
			esac
			;;
	esac

	return 0
}

complete -F _StormByte_StageManager StormByte-StageManager