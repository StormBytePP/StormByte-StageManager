# -----------------------------------------------------------------------------
# Validation helpers
# -----------------------------------------------------------------------------
size_to_mib() {
	local s="$1"
	if [[ "${s}" =~ ^([1-9][0-9]*)([MmGg])$ ]]; then
		local n="${BASH_REMATCH[1]}"
		local u="${BASH_REMATCH[2]}"
		case "${u}" in
			[Mm]) printf '%s\n' "${n}" ;;
			[Gg]) printf '%s\n' "$((n * 1024))" ;;
		esac
		return 0
	fi
	return 1
}

validate_safe_path() {
	local var_name="$1"
	local var_value="$2"
	if [[ "${var_value}" != /* ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} ${var_name} must be an absolute path: ${var_value}"
		return 1
	fi
	if [[ "${var_value}" =~ [^a-zA-Z0-9/_.-] ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} ${var_name} contains unsafe characters: ${var_value}"
		return 1
	fi
	local saved_ifs="${IFS}" part
	IFS='/' read -ra path_parts <<< "${var_value}"
	IFS="${saved_ifs}"
	for part in "${path_parts[@]}"; do
		if [[ "${part}" == ".." ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} ${var_name} contains path traversal (..): ${var_value}"
			return 1
		fi
	done
	return 0
}

check_vars() {
	local errors=0

	# STORAGE_SYSTEM=auto → try zram, else tmpfs, else folder (still respect explicit values)
	if [[ "${STORAGE_SYSTEM}" == "auto" ]]; then
		if [[ -e /dev/zram0 ]] || command -v zramctl >/dev/null 2>&1; then
			STORAGE_SYSTEM="zram"
			info "Storage" "auto → zram"
		elif [[ -d /dev/shm ]]; then
			STORAGE_SYSTEM="tmpfs"
			info "Storage" "auto → tmpfs"
		else
			STORAGE_SYSTEM="folder"
			info "Storage" "auto → folder"
		fi
	fi

	if [[ -z "${STORAGE_SYSTEM}" ]] \
		|| { [[ "${STORAGE_SYSTEM}" != "zram" ]] && [[ "${STORAGE_SYSTEM}" != "tmpfs" ]] && [[ "${STORAGE_SYSTEM}" != "folder" ]]; }; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} STORAGE_SYSTEM invalid (zram|tmpfs|folder|auto)"
		errors=1
	fi
	if [[ "${STORAGE_SYSTEM}" == "zram" || "${STORAGE_SYSTEM}" == "tmpfs" ]]; then
		if ! [[ "${STORAGE_SIZE}" =~ ^[1-9][0-9]*[MG]$ ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} STORAGE_SIZE invalid (e.g. 20G, 512M)"
			errors=1
		fi
	fi
	if [[ "${STORAGE_SYSTEM}" == "zram" && -n "${STORAGE_SYSTEM_ZRAM_COMPRESSION_ALGO:-}" ]]; then
		case "${STORAGE_SYSTEM_ZRAM_COMPRESSION_ALGO}" in
			zstd|lz4|lz4hc) ;;
			*)
				echo "${_CLR_RED}  ✗${_CLR_RESET} STORAGE_SYSTEM_ZRAM_COMPRESSION_ALGO invalid (zstd|lz4|lz4hc)"
				errors=1
				;;
		esac
	fi

	if [[ -z "${TARBALL_FOLDER}" ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} TARBALL_FOLDER is empty"
		errors=1
	elif ! validate_safe_path "TARBALL_FOLDER" "${TARBALL_FOLDER}"; then
		errors=1
	elif [[ ! -d "${TARBALL_FOLDER}" ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} TARBALL_FOLDER does not exist: ${TARBALL_FOLDER}"
		errors=1
	fi

	if [[ ! -f "${TARBALL_NOTE_EDITOR}" ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} TARBALL_NOTE_EDITOR not found: ${TARBALL_NOTE_EDITOR}"
		errors=1
	fi
	if [[ "${DETACH_NOTE_EDITOR}" != "NO" && "${DETACH_NOTE_EDITOR}" != "YES" ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} DETACH_NOTE_EDITOR must be YES or NO"
		errors=1
	fi

	for lvl_name in GZIP_COMPRESSION_LEVEL BZIP_COMPRESSION_LEVEL XZ_COMPRESSION_LEVEL; do
		local lvl="${!lvl_name}"
		if ! [[ "${lvl}" =~ ^[1-9]$ ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} ${lvl_name} must be 1–9"
			errors=1
		fi
	done
	if ! [[ "${ZSTD_COMPRESSION_LEVEL}" =~ ^[0-9]+$ ]] \
		|| [[ "${ZSTD_COMPRESSION_LEVEL}" -lt 1 || "${ZSTD_COMPRESSION_LEVEL}" -gt 19 ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} ZSTD_COMPRESSION_LEVEL must be 1–19"
		errors=1
	fi

	if [[ "${USE_CCACHE}" != "NO" && "${USE_CCACHE}" != "YES" ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} USE_CCACHE must be YES or NO"
		errors=1
	fi
	if [[ "${USE_CCACHE}" == "YES" ]]; then
		if [[ "${USE_CCACHE_BIND}" != "NO" && "${USE_CCACHE_BIND}" != "YES" ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} USE_CCACHE_BIND must be YES or NO"; errors=1
		fi
		if [[ "${USE_CCACHE_FILE}" != "NO" && "${USE_CCACHE_FILE}" != "YES" ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} USE_CCACHE_FILE must be YES or NO"; errors=1
		fi
		if [[ "${USE_CCACHE_BIND}" != "YES" && "${USE_CCACHE_FILE}" != "YES" ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} USE_CCACHE=YES requires BIND or FILE"; errors=1
		elif [[ "${USE_CCACHE_FILE}" == "YES" && "${USE_CCACHE_BIND}" == "YES" ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} Only one of USE_CCACHE_FILE / USE_CCACHE_BIND"; errors=1
		fi
		if [[ -z "${CCACHE_DIR}" ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} CCACHE_DIR empty"; errors=1
		elif ! validate_safe_path "CCACHE_DIR" "${CCACHE_DIR}"; then
			errors=1
		fi
		if [[ ! -d "${CCACHE_DIR}" && "${USE_CCACHE_BIND}" == "YES" ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} CCACHE_DIR does not exist: ${CCACHE_DIR}"; errors=1
		fi
		if [[ -n "${CCACHE_CACHE_SIZE:-}" ]] && ! size_to_mib "${CCACHE_CACHE_SIZE}" >/dev/null; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} CCACHE_CACHE_SIZE invalid (e.g. 8G, 512M)"; errors=1
		fi
		if [[ "${USE_CCACHE_FILE}" == "YES" ]]; then
			local ccache_tmpfs="${CCACHE_TMPFS_SIZE:-${STORAGE_SIZE:-8G}}"
			if ! size_to_mib "${ccache_tmpfs}" >/dev/null; then
				echo "${_CLR_RED}  ✗${_CLR_RESET} CCACHE_TMPFS_SIZE invalid (e.g. 8G): ${ccache_tmpfs}"; errors=1
			elif [[ -n "${CCACHE_CACHE_SIZE:-}" ]]; then
				local cache_mib tmpfs_mib
				cache_mib="$(size_to_mib "${CCACHE_CACHE_SIZE}")"
				tmpfs_mib="$(size_to_mib "${ccache_tmpfs}")"
				if [[ "${cache_mib}" -gt "${tmpfs_mib}" ]]; then
					echo "${_CLR_RED}  ✗${_CLR_RESET} CCACHE_CACHE_SIZE (${CCACHE_CACHE_SIZE}) > FILE workspace (${ccache_tmpfs})"
					errors=1
				fi
			fi
		fi
	fi

	if [[ "${USE_SCCACHE:-NO}" != "NO" && "${USE_SCCACHE}" != "YES" ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} USE_SCCACHE must be YES or NO"; errors=1
	fi
	if [[ "${USE_SCCACHE:-NO}" == "YES" ]]; then
		if [[ "${USE_SCCACHE_BIND}" != "NO" && "${USE_SCCACHE_BIND}" != "YES" ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} USE_SCCACHE_BIND must be YES or NO"; errors=1
		fi
		if [[ "${USE_SCCACHE_FILE}" != "NO" && "${USE_SCCACHE_FILE}" != "YES" ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} USE_SCCACHE_FILE must be YES or NO"; errors=1
		fi
		if [[ "${USE_SCCACHE_BIND}" != "YES" && "${USE_SCCACHE_FILE}" != "YES" ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} USE_SCCACHE=YES requires BIND or FILE"; errors=1
		elif [[ "${USE_SCCACHE_FILE}" == "YES" && "${USE_SCCACHE_BIND}" == "YES" ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} Only one of USE_SCCACHE_FILE / USE_SCCACHE_BIND"; errors=1
		fi
		if [[ -z "${SCCACHE_DIR}" ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} SCCACHE_DIR empty"; errors=1
		elif ! validate_safe_path "SCCACHE_DIR" "${SCCACHE_DIR}"; then
			errors=1
		fi
		if [[ -n "${SCCACHE_CACHE_SIZE:-}" ]] && ! size_to_mib "${SCCACHE_CACHE_SIZE}" >/dev/null; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} SCCACHE_CACHE_SIZE invalid (e.g. 20G, 512M)"; errors=1
		fi
		if [[ "${USE_SCCACHE_FILE}" == "YES" ]]; then
			local sccache_tmpfs="${SCCACHE_TMPFS_SIZE:-${STORAGE_SIZE:-8G}}"
			if ! size_to_mib "${sccache_tmpfs}" >/dev/null; then
				echo "${_CLR_RED}  ✗${_CLR_RESET} SCCACHE_TMPFS_SIZE invalid (e.g. 8G): ${sccache_tmpfs}"; errors=1
			elif [[ -n "${SCCACHE_CACHE_SIZE:-}" ]]; then
				local cache_mib tmpfs_mib
				cache_mib="$(size_to_mib "${SCCACHE_CACHE_SIZE}")"
				tmpfs_mib="$(size_to_mib "${sccache_tmpfs}")"
				if [[ "${cache_mib}" -gt "${tmpfs_mib}" ]]; then
					echo "${_CLR_RED}  ✗${_CLR_RESET} SCCACHE_CACHE_SIZE (${SCCACHE_CACHE_SIZE}) > FILE workspace (${sccache_tmpfs})"
					errors=1
				fi
			fi
		fi
	fi

	for pair in \
		"USE_PKG_BIND:${USE_PKG_BIND}" \
		"USE_DISTFILES_BIND:${USE_DISTFILES_BIND}" \
		"USE_REPOS_BIND:${USE_REPOS_BIND}" \
		"USE_GENTOO_PATCHES_BIND:${USE_GENTOO_PATCHES_BIND}"; do
		local k="${pair%%:*}" v="${pair#*:}"
		if [[ "${v}" != "NO" && "${v}" != "YES" ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} ${k} must be YES or NO"; errors=1
		fi
	done

	if [[ -z "${PKG_DIR}" ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} PKG_DIR empty"; errors=1
	elif ! validate_safe_path "PKG_DIR" "${PKG_DIR}"; then
		errors=1
	elif [[ ! -d "${PKG_DIR}" ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} PKG_DIR does not exist: ${PKG_DIR}"; errors=1
	fi
	if [[ -z "${DISTFILES_DIR}" ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} DISTFILES_DIR empty"; errors=1
	elif ! validate_safe_path "DISTFILES_DIR" "${DISTFILES_DIR}"; then
		errors=1
	elif [[ ! -d "${DISTFILES_DIR}" ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} DISTFILES_DIR does not exist: ${DISTFILES_DIR}"; errors=1
	fi
	if [[ -z "${REPOS_DIR}" ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} REPOS_DIR empty"; errors=1
	elif ! validate_safe_path "REPOS_DIR" "${REPOS_DIR}"; then
		errors=1
	elif [[ ! -d "${REPOS_DIR}" ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} REPOS_DIR does not exist: ${REPOS_DIR}"; errors=1
	fi

	if [[ -n "${EXTRA_BIND_MOUNT:-}" ]]; then
		local saved_ifs="${IFS}" mount_path
		IFS=';' read -ra extra_mounts <<< "${EXTRA_BIND_MOUNT}"
		IFS="${saved_ifs}"
		for mount_path in "${extra_mounts[@]}"; do
			[[ -z "${mount_path}" ]] && continue
			if ! validate_safe_path "EXTRA_BIND_MOUNT entry" "${mount_path}"; then
				errors=1
				continue
			fi
			case "${mount_path}" in
				/|/dev|/sys|/proc|/run|/tmp|/boot|/root)
					echo "${_CLR_RED}  ✗${_CLR_RESET} EXTRA_BIND_MOUNT rejects protected path: ${mount_path}"
					errors=1
					;;
			esac
			if [[ ! -e "${mount_path}" ]]; then
				echo "${_CLR_RED}  ✗${_CLR_RESET} EXTRA_BIND_MOUNT path does not exist: ${mount_path}"
				errors=1
			fi
		done
	fi

	# Refresh sidecar paths after TARBALL_FOLDER is known good
	ccache_file="${TARBALL_FOLDER}/ccache.tbz2"
	sccache_file="${TARBALL_FOLDER}/sccache.tbz2"

	[[ "${errors}" -eq 0 ]] || displayError "Configuration validation failed"
}

# -----------------------------------------------------------------------------
# Stage selection
# -----------------------------------------------------------------------------
refresh_file_list() {
	# Same ordering as pre-1.0.0: shorter paths first (awk length | sort -n).
	# Recursive under TARBALL_FOLDER; full paths in file_list; skip cache sidecars.
	local root
	root="$(cd "${TARBALL_FOLDER}" && pwd)" \
		|| displayError "Cannot access TARBALL_FOLDER: ${TARBALL_FOLDER}"

	mapfile -t file_list < <(
		find "${root}" -type f \
			-iregex '.*\.\(tar\.gz\|tgz\|tar\.bz2\|tbz2\|tar\.xz\|txz\|tar\.zstd\|tar\.zst\|tzd\)$' \
			! -name 'ccache.tbz2' \
			! -name 'sccache.tbz2' \
			-print 2>/dev/null \
		| awk '{ print length, $0 }' \
		| sort -n \
		| cut -d' ' -f2-
	)
}

set_and_check_file() {
	# Optional $1 = explicit full path (rebase internal). Else parameters[1] = index|name|relative
	if [[ "$#" -ge 1 && -n "${1:-}" ]]; then
		tarball_filename_fullpath="$1"
	else
		local sel="${parameters[1]:-}"
		[[ -n "${sel}" ]] || usage_error "Missing stage index or filename" \
			"${SCRIPT_NAME} <cmd> <index|filename> …"

		if [[ "${sel}" =~ ^[0-9]+$ ]]; then
			if [[ -z "${file_list[${sel}]:-}" ]]; then
				displayError "Index ${sel} is out of range (run: ${SCRIPT_NAME} list)"
			fi
			tarball_filename_fullpath="${file_list[${sel}]}"
		else
			local root candidate="" f
			root="$(cd "${TARBALL_FOLDER}" && pwd)"

			# absolute path
			if [[ "${sel}" == /* && -f "${sel}" ]]; then
				candidate="${sel}"
			# relative to TARBALL_FOLDER (e.g. sub/dir/stage.tzd)
			elif [[ -f "${root}/${sel}" ]]; then
				candidate="${root}/${sel}"
			else
				# basename match among listed stages (first hit)
				for f in "${file_list[@]}"; do
					if [[ "$(basename "${f}")" == "$(basename "${sel}")" ]]; then
						candidate="${f}"
						break
					fi
				done
			fi

			[[ -n "${candidate}" && -f "${candidate}" ]] \
				|| displayError "Stage not found: ${sel}"
			tarball_filename_fullpath="${candidate}"
		fi
	fi

	if [[ ! -f "${tarball_filename_fullpath}" ]]; then
		displayError "File ${tarball_filename_fullpath} does not exist"
	fi

	tarball="$(basename "${tarball_filename_fullpath}")"
	case "${tarball}" in
		*.tar.gz)   tarball_filename="${tarball%.tar.gz}";   tarball_extension="tar.gz" ;;
		*.tar.bz2)  tarball_filename="${tarball%.tar.bz2}";  tarball_extension="tar.bz2" ;;
		*.tar.xz)   tarball_filename="${tarball%.tar.xz}";   tarball_extension="tar.xz" ;;
		*.tar.zstd) tarball_filename="${tarball%.tar.zstd}"; tarball_extension="tar.zstd" ;;
		*.tar.zst)  tarball_filename="${tarball%.tar.zst}";  tarball_extension="tar.zst" ;;
		*)
			tarball_filename="${tarball%.*}"
			tarball_extension="${tarball##*.}"
			;;
	esac
	set_compression "${tarball_extension}"
	set_decompression "${tarball_extension}"
	lockfile="/tmp/.${tarball}.lock"
	if [[ -z "${tarball_extension}" ]]; then
		displayError "Tarball extension is empty"
	fi
}

set_compression_from_name() {
	local name="$1"
	case "${name}" in
		*.tar.gz|*.tgz)   compress="${gzip}";  tarball_extension="tar.gz" ;;
		*.tar.bz2|*.tbz2) compress="${bzip2}"; tarball_extension="tar.bz2" ;;
		*.tar.xz|*.txz)   compress="${xz}";    tarball_extension="tar.xz" ;;
		*.tar.zst|*.tzd)  compress="${zstd}";  tarball_extension="tar.zst" ;;
		*) displayError "Unknown compression for: ${name}" ;;
	esac
}

set_compression() {
	local fmt="$1"
	case "${fmt}" in
		gzip)  compress="${gzip}";  tarball_output="${tarball_filename%.*}.tar.gz"  ;;
		bzip2) compress="${bzip2}"; tarball_output="${tarball_filename%.*}.tar.bz2" ;;
		xz)    compress="${xz}";    tarball_output="${tarball_filename%.*}.tar.xz"  ;;
		zstd)  compress="${zstd}";  tarball_output="${tarball_filename%.*}.tar.zst" ;;
		*) displayError "Unknown format: ${fmt} (gzip|bzip2|xz|zstd)" ;;
	esac
}

set_decompression() {
	local ext="$1"
	case "${ext}" in
		gz|tar.gz|tgz)   extract="gzip -d -c" ;;
		bz2|tar.bz2|tbz2) extract="bzip2 -d -c" ;;
		xz|tar.xz|txz)   extract="xz -d -c" ;;
		zst|tar.zst|tzd) extract="zstd -d -c" ;;
		*) displayError "Unknown archive extension: ${ext}" ;;
	esac
}

set_output_folder() {
	output_folder="${TARBALL_FOLDER}"
}

check_file_copy() {
	local src="$1" dest_name="$2"
	[[ -e "${TARBALL_FOLDER}/${dest_name}" ]] && displayError "Target already exists: ${dest_name}"
	[[ -f "${src}" ]] || displayError "Source missing: ${src}"
}

# -----------------------------------------------------------------------------
# Lock
# -----------------------------------------------------------------------------
do_lock() {
	if [[ "${DRY_RUN}" == "1" ]]; then
		log "  [dry-run] would set lockfile ${lockfile}"
		return 0
	fi
	printStep "Setting lockfile"
	if ! (set -o noclobber; : > "${lockfile}") 2>/dev/null; then
		printFail
		printf "\n  ${_CLR_BOLD_RED}Another instance is already running.${_CLR_RESET}\n"
		printf "  Lockfile: ${_CLR_CYAN}%s${_CLR_RESET}\n" "${lockfile}"
		printf "  ${_CLR_DIM}If this is an error, manually delete the lockfile.${_CLR_RESET}\n\n"
		exit "${E_RUNTIME}"
	fi
	printOK
}

do_unlock() {
	if [[ "${DRY_RUN}" == "1" ]]; then
		return 0
	fi
	handleCommand "rm -f ${lockfile}" "Removing lockfile"
}

# -----------------------------------------------------------------------------
# Temporary storage
# -----------------------------------------------------------------------------
create_tmp_folder() {
	if [[ "${DRY_RUN}" == "1" ]]; then
		tmp_folder="/tmp/dry-run-stage-manager"
		log "  [dry-run] tmp_folder=${tmp_folder}"
		return 0
	fi
	printStep "Creating temporary folder"
	tmp_folder="$(mktemp -d -t "tmp.${tarball_filename:-stage}.XXXXXXXX")" \
		|| { printFail; displayError "Failed to create temporary folder"; }
	printOK
	printf "  ${_CLR_DIM}%s${_CLR_RESET}\n" "${tmp_folder}"
}

delete_tmp_folder() {
	[[ -z "${tmp_folder:-}" ]] && return 0
	if [[ "${DRY_RUN}" == "1" ]]; then
		return 0
	fi
	handleCommand "rm -Rf ${tmp_folder}" "Deleting temporary folder"
	tmp_folder=""
}

mount_folder() { mkdir -p "${tmp_folder}"; }

mount_zram() {
	mkdir -p "${tmp_folder}"
	zram_device_full="$(zramctl -f 2>/dev/null || true)"
	zram_device="$(basename "${zram_device_full:-}")"
	if [[ -z "${zram_device}" ]]; then
		warn "No free ZRAM device — falling back to tmpfs"
		STORAGE_SYSTEM="tmpfs"
		mount_tmpfs
		return 0
	fi
	handleCommand "echo 1 > /sys/block/${zram_device}/reset" "Resetting ZRAM ${zram_device}"
	if [[ -n "${STORAGE_SYSTEM_ZRAM_COMPRESSION_ALGO:-}" ]]; then
		handleCommand "printf '%s\n' '${STORAGE_SYSTEM_ZRAM_COMPRESSION_ALGO}' > /sys/block/${zram_device}/comp_algorithm" \
			"ZRAM compression ${STORAGE_SYSTEM_ZRAM_COMPRESSION_ALGO}"
	fi
	handleCommand "echo '${STORAGE_SIZE}' > /sys/block/${zram_device}/disksize" "ZRAM size ${STORAGE_SIZE}"
	handleCommand "mkfs.ext2 -F -q ${zram_device_full}" "Creating ext2 on ZRAM"
	handleCommand "mount -t ext2 -o noatime,nodiratime,discard ${zram_device_full} '${tmp_folder}'" "Mounting ZRAM"
}

mount_tmpfs() {
	mkdir -p "${tmp_folder}"
	handleCommand "mount -t tmpfs -o size=${STORAGE_SIZE} tmpfs ${tmp_folder}" "Mounting tmpfs"
}

unmount_folder() { cd "${current_folder}"; }

unmount_zram() {
	cd "${current_folder}"
	[[ -z "${tmp_folder:-}" ]] && return 0
	handleCommand "umount -Rl ${tmp_folder}" "Unmounting ZRAM"
	handleCommand "rm -Rf ${tmp_folder}" "Clearing ZRAM mountpoint data"
	handleCommand "sync" "Flushing"
	if [[ -n "${zram_device:-}" ]]; then
		handleCommand "echo 1 > /sys/block/${zram_device}/reset" "Deactivating ${zram_device}"
	fi
}

unmount_tmpfs() {
	cd "${current_folder}"
	handleCommand "umount -R ${tmp_folder}" "Unmounting tmpfs"
}

mount_temp() {
	case "${STORAGE_SYSTEM}" in
		folder) mount_folder ;;
		tmpfs)  mount_tmpfs ;;
		zram)   mount_zram ;;
	esac
}

unmount_temp() {
	case "${STORAGE_SYSTEM}" in
		folder) unmount_folder ;;
		tmpfs)  unmount_tmpfs ;;
		zram)   unmount_zram ;;
	esac
}

readonly_temp() {
	if [[ "${STORAGE_SYSTEM}" != "folder" ]]; then
		handleCommand "mount -o remount,ro ${tmp_folder}" "Making stage filesystem readonly"
	fi
}

