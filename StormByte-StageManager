	if [[ "${USE_GENTOO_PATCHES_BIND}" == "YES" ]] \
		&& [[ -d "${tmp_folder}/etc/portage/patches" ]] \
		&& mountpoint -q "${tmp_folder}/etc/portage/patches"; then
		handleCommand "umount ${tmp_folder}/etc/portage/patches" "Unmounting patches"
	fi
