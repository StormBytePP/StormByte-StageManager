# -----------------------------------------------------------------------------
# Compression / extensions
# -----------------------------------------------------------------------------

# @brief Map an archive extension (any accepted alias) to gzip|bzip2|xz|zstd.
# @param $1 Extension without a leading dot, or a compound like tar.gz.
# @return 0 and prints the format; 1 if unknown.
# @note To be moved to functions.sh (generic compressor table).
format_from_extension() {
	local ext="$1"
	case "${ext}" in
		gz|tar.gz|tgz|tgzip)                 printf 'gzip\n' ;;
		bz2|tar.bz2|tbz2|tbzip2)             printf 'bzip2\n' ;;
		xz|tar.xz|txz)                       printf 'xz\n' ;;
		zst|zstd|tar.zst|tar.zstd|tzd|tzstd) printf 'zstd\n' ;;
		*) return 1 ;;
	esac
}

# @brief Canonical short extension written by convert / default save.
# @param $1 Format name or alias (gzip, tgzip, zstd, tzd, …).
# @return 0 and prints tgzip|tbzip2|txz|tzd; 1 if unknown.
# @note To be moved to functions.sh (pairs with format_from_extension).
canonical_extension() {
	case "$1" in
		gzip|tgzip)     printf 'tgzip\n' ;;
		bzip2|tbzip2)   printf 'tbzip2\n' ;;
		xz|txz)         printf 'txz\n' ;;
		zstd|tzd|tzstd) printf 'tzd\n' ;;
		*) return 1 ;;
	esac
}

# @brief Split a basename into stem + extension and set tarball_format.
# @param $1 Basename of a stage archive.
parse_tarball_name() {
	local name="$1"
	case "${name}" in
		*.tar.gz)   tarball_filename="${name%.tar.gz}";   tarball_extension="tar.gz" ;;
		*.tar.bz2)  tarball_filename="${name%.tar.bz2}";  tarball_extension="tar.bz2" ;;
		*.tar.xz)   tarball_filename="${name%.tar.xz}";   tarball_extension="tar.xz" ;;
		*.tar.zstd) tarball_filename="${name%.tar.zstd}"; tarball_extension="tar.zstd" ;;
		*.tar.zst)  tarball_filename="${name%.tar.zst}";  tarball_extension="tar.zst" ;;
		*.tgzip)    tarball_filename="${name%.tgzip}";    tarball_extension="tgzip" ;;
		*.tbzip2)   tarball_filename="${name%.tbzip2}";   tarball_extension="tbzip2" ;;
		*.tzstd)    tarball_filename="${name%.tzstd}";    tarball_extension="tzstd" ;;
		*.tzd)      tarball_filename="${name%.tzd}";      tarball_extension="tzd" ;;
		*.tgz)      tarball_filename="${name%.tgz}";      tarball_extension="tgz" ;;
		*.tbz2)     tarball_filename="${name%.tbz2}";     tarball_extension="tbz2" ;;
		*.txz)      tarball_filename="${name%.txz}";      tarball_extension="txz" ;;
		*)
			tarball_filename="${name%.*}"
			tarball_extension="${name##*.}"
			;;
	esac
	tarball_format="$(format_from_extension "${tarball_extension}")" \
		|| displayError "Unknown format: ${tarball_extension} (gzip|bzip2|xz|zstd / tgzip|tbzip2|txz|tzd|tzstd)"
}

# @brief Set $compress from an extension. Does not rewrite tarball_output.
# @param $1 Extension as stored in tarball_extension.
set_codec_from_extension() {
	local ext="$1"
	local fmt
	fmt="$(format_from_extension "${ext}")" \
		|| displayError "Unknown format: ${ext} (gzip|bzip2|xz|zstd / tgzip|tbzip2|txz|tzd|tzstd)"
	tarball_format="${fmt}"
	case "${fmt}" in
		gzip)  compress="${gzip}" ;;
		bzip2) compress="${bzip2}" ;;
		xz)    compress="${xz}" ;;
		zstd)  compress="${zstd}" ;;
	esac
}

# @brief Set codec from a destination filename (rebase / named save).
# @param $1 Path or basename whose extension selects the compressor.
set_compression_from_name() {
	local name="$1"
	parse_tarball_name "$(basename "${name}")"
	set_codec_from_extension "${tarball_extension}"
}

# @brief Set codec + tarball_output from a convert/export format name.
# @param $1 gzip|bzip2|xz|zstd or a short alias.
# @note Writes the canonical short extension. Stem is tarball_filename
#       (already stripped). Does not extract or mount.
set_compression() {
	local fmt="$1"
	local ext
	ext="$(canonical_extension "${fmt}")" \
		|| displayError "Unknown format: ${fmt} (gzip|bzip2|xz|zstd)"
	case "$(format_from_extension "${ext}")" in
		gzip)  compress="${gzip}" ;;
		bzip2) compress="${bzip2}" ;;
		xz)    compress="${xz}" ;;
		zstd)  compress="${zstd}" ;;
	esac
	tarball_format="$(format_from_extension "${ext}")"
	tarball_output="${tarball_filename}.${ext}"
}

# @brief Set $extract (decompress-to-stdout) from an extension.
# @param $1 Extension alias.
set_decompression() {
	local ext="$1"
	local fmt
	fmt="$(format_from_extension "${ext}")" \
		|| displayError "Unknown archive extension: ${ext}"
	case "${fmt}" in
		gzip)  extract="gzip -d -c" ;;
		bzip2) extract="bzip2 -d -c" ;;
		xz)    extract="xz -d -c" ;;
		zstd)  extract="zstd -d -c" ;;
	esac
}

# -----------------------------------------------------------------------------
# Stage selection
# -----------------------------------------------------------------------------

# @brief Rebuild file_list: recursive under TARBALL_FOLDER, shorter paths first.
# @note Sidecars ccache.tbz2 / sccache.tbz2 are never stages.
refresh_file_list() {
	local root
	root="$(cd "${TARBALL_FOLDER}" && pwd)" \
		|| displayError "Cannot access TARBALL_FOLDER: ${TARBALL_FOLDER}"

	mapfile -t file_list < <(
		find "${root}" -type f \
			-iregex '.*\.\(tar\.gz\|tgz\|tgzip\|tar\.bz2\|tbz2\|tbzip2\|tar\.xz\|txz\|tar\.zstd\|tar\.zst\|tzstd\|tzd\)$' \
			! -name 'ccache.tbz2' \
			! -name 'sccache.tbz2' \
			-print 2>/dev/null \
		| awk '{ print length, $0 }' \
		| sort -n \
		| cut -d' ' -f2-
	)
}

# @brief Resolve parameters[1] (or $1) to an existing stage and set codec.
# @param $1 Optional explicit full path (must exist). Otherwise index|name.
# @note Calls set_codec + set_decompression. Does NOT call set_compression
#       (that would rewrite the output name). tarball_output defaults to the
#       current basename so use can overwrite in place.
set_and_check_file() {
	if [[ "$#" -ge 1 && -n "${1:-}" ]]; then
		tarball_filename_fullpath="$1"
	else
		local sel="${parameters[1]:-}"
		[[ -n "${sel}" ]] || usage_error "Missing stage index or filename" \
			"${SCRIPT_NAME} <cmd> <index|filename> …"

		if [[ "${sel}" =~ ^[0-9]+$ ]]; then
			if [[ -z "${file_list[${sel}]:-}" ]]; then
				displayError "Index ${sel} is out of range (run: ${SCRIPT_NAME} list)"
			fi
			tarball_filename_fullpath="${file_list[${sel}]}"
		else
			local root candidate="" f
			root="$(cd "${TARBALL_FOLDER}" && pwd)"

			if [[ "${sel}" == /* && -f "${sel}" ]]; then
				candidate="${sel}"
			elif [[ -f "${root}/${sel}" ]]; then
				candidate="${root}/${sel}"
			else
				for f in "${file_list[@]}"; do
					if [[ "$(basename "${f}")" == "$(basename "${sel}")" ]]; then
						candidate="${f}"
						break
					fi
				done
			fi

			[[ -n "${candidate}" && -f "${candidate}" ]] \
				|| displayError "Stage not found: ${sel}"
			tarball_filename_fullpath="${candidate}"
		fi
	fi

	if [[ ! -f "${tarball_filename_fullpath}" ]]; then
		displayError "File ${tarball_filename_fullpath} does not exist"
	fi

	tarball="$(basename "${tarball_filename_fullpath}")"
	parse_tarball_name "${tarball}"
	set_codec_from_extension "${tarball_extension}"
	set_decompression "${tarball_extension}"
	tarball_output="${tarball}"
	lockfile="/tmp/.${tarball}.lock"
	if [[ -z "${tarball_extension}" ]]; then
		displayError "Tarball extension is empty"
	fi
}

# @brief Default output folder is TARBALL_FOLDER (convert; export overrides).
set_output_folder() {
	output_folder="${TARBALL_FOLDER}"
}

# @brief Abort if dest basename already exists under TARBALL_FOLDER.
# @param $1 Source path.
# @param $2 Destination basename.
check_file_copy() {
	local src="$1" dest_name="$2"
	[[ -e "${TARBALL_FOLDER}/${dest_name}" ]] && displayError "Target already exists: ${dest_name}"
	[[ -f "${src}" ]] || displayError "Source missing: ${src}"
}

# -----------------------------------------------------------------------------
# Stream recompress (convert / export) — no extract, no STORAGE_* mounts
# -----------------------------------------------------------------------------

# @brief Copy or stream-recompress src to dest.
# @param $1 Source archive (absolute).
# @param $2 Destination archive (absolute).
# @param $3 Destination format: gzip|bzip2|xz|zstd.
# @note Same codec → cp --reflink=auto (fallback cp). Different codec →
#       pv | decompress | compress > dest.partial && mv. Ctrl-C deletes
#       dest.partial only. Ignores STORAGE_SYSTEM / STORAGE_SIZE.
#       To be moved to functions.sh once the codec table lives there.
recompress_stage() {
	local src="$1" dest="$2" dest_fmt="$3"
	local src_fmt dest_dir dest_base partial
	src_fmt="$(format_from_extension "${tarball_extension}")" \
		|| displayError "Unknown source format: ${tarball_extension}"
	dest_dir="$(dirname "${dest}")"
	dest_base="$(basename "${dest}")"
	[[ -d "${dest_dir}" ]] || displayError "Destination folder does not exist: ${dest_dir}"

	if [[ "${src}" == "${dest}" ]]; then
		info "Convert" "source and destination are the same file — nothing to do"
		return 0
	fi
	if [[ -e "${dest}" ]]; then
		displayError "Target ${dest_base} already exists"
	fi

	if [[ "${DRY_RUN}" == "1" ]]; then
		if [[ "${src_fmt}" == "${dest_fmt}" ]]; then
			log "  [dry-run] would copy ${src} → ${dest}"
		else
			log "  [dry-run] would stream ${src_fmt} → ${dest_fmt}: ${dest}"
		fi
		return 0
	fi

	partial="${dest_dir}/.${dest_base}.partial"
	_partial_path="${partial}"
	rm -f "${partial}"

	phase_start
	if [[ "${src_fmt}" == "${dest_fmt}" ]]; then
		printf "  ${_CLR_BOLD_CYAN}◆${_CLR_RESET} ${_CLR_WHITE}Copying %s${_CLR_RESET} ${_CLR_DIM}…${_CLR_RESET}\n" "${dest_base}"
		if cp --reflink=auto -f "${src}" "${partial}" 2>/dev/null || cp -f "${src}" "${partial}"; then
			mv -f "${partial}" "${dest}"
			_partial_path=""
			remember_artifact "${dest}"
			phase_end "Copy"
			return 0
		fi
		displayError "Copy failed: ${src} → ${dest}"
	fi

	set_decompression "${tarball_extension}"
	case "${dest_fmt}" in
		gzip)  compress="${gzip}" ;;
		bzip2) compress="${bzip2}" ;;
		xz)    compress="${xz}" ;;
		zstd)  compress="${zstd}" ;;
		*) displayError "Unknown destination format: ${dest_fmt}" ;;
	esac

	printf "  ${_CLR_BOLD_CYAN}◆${_CLR_RESET} ${_CLR_WHITE}Streaming %s → %s${_CLR_RESET} ${_CLR_DIM}…${_CLR_RESET}\n" \
		"${src_fmt}" "${dest_fmt}"
	if pv "${src}" | ${extract} | ${compress} > "${partial}"; then
		mv -f "${partial}" "${dest}"
		_partial_path=""
		remember_artifact "${dest}"
		phase_end "Stream"
		return 0
	fi
	rm -f "${partial}"
	_partial_path=""
	displayError "Stream recompress failed"
}

# -----------------------------------------------------------------------------
# Validation helpers
# -----------------------------------------------------------------------------

# @brief Parse a size token (512M / 20G) into integer MiB.
# @param $1 Size string.
# @return 0 and prints MiB; 1 if the token is not N+M/G.
# @note To be moved to functions.sh (pairs with human_size).
size_to_mib() {
	local s="$1"
	if [[ "${s}" =~ ^([1-9][0-9]*)([MmGg])$ ]]; then
		local n="${BASH_REMATCH[1]}"
		local u="${BASH_REMATCH[2]}"
		case "${u}" in
			[Mm]) printf '%s\n' "${n}" ;;
			[Gg]) printf '%s\n' "$((n * 1024))" ;;
		esac
		return 0
	fi
	return 1
}

# @brief Reject relative paths, traversal, and odd characters in conf paths.
# @param $1 Variable name (for the error line).
# @param $2 Absolute path to validate.
# @return 0 if acceptable; 1 and prints a ✗ line otherwise.
validate_safe_path() {
	local var_name="$1"
	local var_value="$2"
	if [[ "${var_value}" != /* ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} ${var_name} must be an absolute path: ${var_value}"
		return 1
	fi
	if [[ "${var_value}" =~ [^a-zA-Z0-9/_.-] ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} ${var_name} contains unsafe characters: ${var_value}"
		return 1
	fi
	local saved_ifs="${IFS}" part
	IFS='/' read -ra path_parts <<< "${var_value}"
	IFS="${saved_ifs}"
	for part in "${path_parts[@]}"; do
		if [[ "${part}" == ".." ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} ${var_name} contains path traversal (..): ${var_value}"
			return 1
		fi
	done
	return 0
}

# @brief Validate every conf key. STORAGE_SYSTEM=auto is resolved here.
# @note convert/export never call mount_temp; they still pass this check so
#       a broken conf fails the same way as use. Sidecar paths are refreshed
#       after TARBALL_FOLDER is known good. Keys themselves are unchanged.
check_vars() {
	local errors=0

	if [[ "${STORAGE_SYSTEM}" == "auto" ]]; then
		if [[ -e /dev/zram0 ]] || command -v zramctl >/dev/null 2>&1; then
			STORAGE_SYSTEM="zram"
			info "Storage" "auto → zram"
		elif [[ -d /dev/shm ]]; then
			STORAGE_SYSTEM="tmpfs"
			info "Storage" "auto → tmpfs"
		else
			STORAGE_SYSTEM="folder"
			info "Storage" "auto → folder"
		fi
	fi

	if [[ -z "${STORAGE_SYSTEM}" ]] \
		|| { [[ "${STORAGE_SYSTEM}" != "zram" ]] && [[ "${STORAGE_SYSTEM}" != "tmpfs" ]] && [[ "${STORAGE_SYSTEM}" != "folder" ]]; }; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} STORAGE_SYSTEM invalid (zram|tmpfs|folder|auto)"
		errors=1
	fi
	if [[ "${STORAGE_SYSTEM}" == "zram" || "${STORAGE_SYSTEM}" == "tmpfs" ]]; then
		if ! [[ "${STORAGE_SIZE}" =~ ^[1-9][0-9]*[MG]$ ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} STORAGE_SIZE invalid (e.g. 20G, 512M)"
			errors=1
		fi
	fi
	if [[ "${STORAGE_SYSTEM}" == "zram" && -n "${STORAGE_SYSTEM_ZRAM_COMPRESSION_ALGO:-}" ]]; then
		case "${STORAGE_SYSTEM_ZRAM_COMPRESSION_ALGO}" in
			zstd|lz4|lz4hc) ;;
			*)
				echo "${_CLR_RED}  ✗${_CLR_RESET} STORAGE_SYSTEM_ZRAM_COMPRESSION_ALGO invalid (zstd|lz4|lz4hc)"
				errors=1
				;;
		esac
	fi

	if [[ -z "${TARBALL_FOLDER}" ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} TARBALL_FOLDER is empty"
		errors=1
	elif ! validate_safe_path "TARBALL_FOLDER" "${TARBALL_FOLDER}"; then
		errors=1
	elif [[ ! -d "${TARBALL_FOLDER}" ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} TARBALL_FOLDER does not exist: ${TARBALL_FOLDER}"
		errors=1
	fi

	if [[ ! -f "${TARBALL_NOTE_EDITOR}" ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} TARBALL_NOTE_EDITOR not found: ${TARBALL_NOTE_EDITOR}"
		errors=1
	fi
	if [[ "${DETACH_NOTE_EDITOR}" != "NO" && "${DETACH_NOTE_EDITOR}" != "YES" ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} DETACH_NOTE_EDITOR must be YES or NO"
		errors=1
	fi

	for lvl_name in GZIP_COMPRESSION_LEVEL BZIP_COMPRESSION_LEVEL XZ_COMPRESSION_LEVEL; do
		local lvl="${!lvl_name}"
		if ! [[ "${lvl}" =~ ^[1-9]$ ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} ${lvl_name} must be 1–9"
			errors=1
		fi
	done
	if ! [[ "${ZSTD_COMPRESSION_LEVEL}" =~ ^[0-9]+$ ]] \
		|| [[ "${ZSTD_COMPRESSION_LEVEL}" -lt 1 || "${ZSTD_COMPRESSION_LEVEL}" -gt 19 ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} ZSTD_COMPRESSION_LEVEL must be 1–19"
		errors=1
	fi

	if [[ "${USE_CCACHE}" != "NO" && "${USE_CCACHE}" != "YES" ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} USE_CCACHE must be YES or NO"
		errors=1
	fi
	if [[ "${USE_CCACHE}" == "YES" ]]; then
		if [[ "${USE_CCACHE_BIND}" != "NO" && "${USE_CCACHE_BIND}" != "YES" ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} USE_CCACHE_BIND must be YES or NO"; errors=1
		fi
		if [[ "${USE_CCACHE_FILE}" != "NO" && "${USE_CCACHE_FILE}" != "YES" ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} USE_CCACHE_FILE must be YES or NO"; errors=1
		fi
		if [[ "${USE_CCACHE_BIND}" != "YES" && "${USE_CCACHE_FILE}" != "YES" ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} USE_CCACHE=YES requires BIND or FILE"; errors=1
		elif [[ "${USE_CCACHE_FILE}" == "YES" && "${USE_CCACHE_BIND}" == "YES" ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} Only one of USE_CCACHE_FILE / USE_CCACHE_BIND"; errors=1
		fi
		if [[ -z "${CCACHE_DIR}" ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} CCACHE_DIR empty"; errors=1
		elif ! validate_safe_path "CCACHE_DIR" "${CCACHE_DIR}"; then
			errors=1
		fi
		if [[ ! -d "${CCACHE_DIR}" && "${USE_CCACHE_BIND}" == "YES" ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} CCACHE_DIR does not exist: ${CCACHE_DIR}"; errors=1
		fi
		if [[ -n "${CCACHE_CACHE_SIZE:-}" ]] && ! size_to_mib "${CCACHE_CACHE_SIZE}" >/dev/null; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} CCACHE_CACHE_SIZE invalid (e.g. 8G, 512M)"; errors=1
		fi
		if [[ "${USE_CCACHE_FILE}" == "YES" ]]; then
			local ccache_tmpfs="${CCACHE_TMPFS_SIZE:-${STORAGE_SIZE:-8G}}"
			if ! size_to_mib "${ccache_tmpfs}" >/dev/null; then
				echo "${_CLR_RED}  ✗${_CLR_RESET} CCACHE_TMPFS_SIZE invalid (e.g. 8G): ${ccache_tmpfs}"; errors=1
			elif [[ -n "${CCACHE_CACHE_SIZE:-}" ]]; then
				local cache_mib tmpfs_mib
				cache_mib="$(size_to_mib "${CCACHE_CACHE_SIZE}")"
				tmpfs_mib="$(size_to_mib "${ccache_tmpfs}")"
				if [[ "${cache_mib}" -gt "${tmpfs_mib}" ]]; then
					echo "${_CLR_RED}  ✗${_CLR_RESET} CCACHE_CACHE_SIZE (${CCACHE_CACHE_SIZE}) > FILE workspace (${ccache_tmpfs})"
					errors=1
				fi
			fi
		fi
	fi

	if [[ "${USE_SCCACHE:-NO}" != "NO" && "${USE_SCCACHE}" != "YES" ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} USE_SCCACHE must be YES or NO"; errors=1
	fi
	if [[ "${USE_SCCACHE:-NO}" == "YES" ]]; then
		if [[ "${USE_SCCACHE_BIND}" != "NO" && "${USE_SCCACHE_BIND}" != "YES" ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} USE_SCCACHE_BIND must be YES or NO"; errors=1
		fi
		if [[ "${USE_SCCACHE_FILE}" != "NO" && "${USE_SCCACHE_FILE}" != "YES" ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} USE_SCCACHE_FILE must be YES or NO"; errors=1
		fi
		if [[ "${USE_SCCACHE_BIND}" != "YES" && "${USE_SCCACHE_FILE}" != "YES" ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} USE_SCCACHE=YES requires BIND or FILE"; errors=1
		elif [[ "${USE_SCCACHE_FILE}" == "YES" && "${USE_SCCACHE_BIND}" == "YES" ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} Only one of USE_SCCACHE_FILE / USE_SCCACHE_BIND"; errors=1
		fi
		if [[ -z "${SCCACHE_DIR}" ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} SCCACHE_DIR empty"; errors=1
		elif ! validate_safe_path "SCCACHE_DIR" "${SCCACHE_DIR}"; then
			errors=1
		fi
		if [[ -n "${SCCACHE_CACHE_SIZE:-}" ]] && ! size_to_mib "${SCCACHE_CACHE_SIZE}" >/dev/null; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} SCCACHE_CACHE_SIZE invalid (e.g. 20G, 512M)"; errors=1
		fi
		if [[ "${USE_SCCACHE_FILE}" == "YES" ]]; then
			local sccache_tmpfs="${SCCACHE_TMPFS_SIZE:-${STORAGE_SIZE:-8G}}"
			if ! size_to_mib "${sccache_tmpfs}" >/dev/null; then
				echo "${_CLR_RED}  ✗${_CLR_RESET} SCCACHE_TMPFS_SIZE invalid (e.g. 8G): ${sccache_tmpfs}"; errors=1
			elif [[ -n "${SCCACHE_CACHE_SIZE:-}" ]]; then
				local cache_mib tmpfs_mib
				cache_mib="$(size_to_mib "${SCCACHE_CACHE_SIZE}")"
				tmpfs_mib="$(size_to_mib "${sccache_tmpfs}")"
				if [[ "${cache_mib}" -gt "${tmpfs_mib}" ]]; then
					echo "${_CLR_RED}  ✗${_CLR_RESET} SCCACHE_CACHE_SIZE (${SCCACHE_CACHE_SIZE}) > FILE workspace (${sccache_tmpfs})"
					errors=1
				fi
			fi
		fi
	fi

	for pair in \
		"USE_PKG_BIND:${USE_PKG_BIND}" \
		"USE_DISTFILES_BIND:${USE_DISTFILES_BIND}" \
		"USE_REPOS_BIND:${USE_REPOS_BIND}" \
		"USE_GENTOO_PATCHES_BIND:${USE_GENTOO_PATCHES_BIND}"; do
		local k="${pair%%:*}" v="${pair#*:}"
		if [[ "${v}" != "NO" && "${v}" != "YES" ]]; then
			echo "${_CLR_RED}  ✗${_CLR_RESET} ${k} must be YES or NO"; errors=1
		fi
	done

	if [[ -z "${PKG_DIR}" ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} PKG_DIR empty"; errors=1
	elif ! validate_safe_path "PKG_DIR" "${PKG_DIR}"; then
		errors=1
	elif [[ ! -d "${PKG_DIR}" ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} PKG_DIR does not exist: ${PKG_DIR}"; errors=1
	fi
	if [[ -z "${DISTFILES_DIR}" ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} DISTFILES_DIR empty"; errors=1
	elif ! validate_safe_path "DISTFILES_DIR" "${DISTFILES_DIR}"; then
		errors=1
	elif [[ ! -d "${DISTFILES_DIR}" ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} DISTFILES_DIR does not exist: ${DISTFILES_DIR}"; errors=1
	fi
	if [[ -z "${REPOS_DIR}" ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} REPOS_DIR empty"; errors=1
	elif ! validate_safe_path "REPOS_DIR" "${REPOS_DIR}"; then
		errors=1
	elif [[ ! -d "${REPOS_DIR}" ]]; then
		echo "${_CLR_RED}  ✗${_CLR_RESET} REPOS_DIR does not exist: ${REPOS_DIR}"; errors=1
	fi

	if [[ -n "${EXTRA_BIND_MOUNT:-}" ]]; then
		local saved_ifs="${IFS}" mount_path
		IFS=';' read -ra extra_mounts <<< "${EXTRA_BIND_MOUNT}"
		IFS="${saved_ifs}"
		for mount_path in "${extra_mounts[@]}"; do
			[[ -z "${mount_path}" ]] && continue
			if ! validate_safe_path "EXTRA_BIND_MOUNT entry" "${mount_path}"; then
				errors=1
				continue
			fi
			case "${mount_path}" in
				/|/dev|/sys|/proc|/run|/tmp|/boot|/root)
					echo "${_CLR_RED}  ✗${_CLR_RESET} EXTRA_BIND_MOUNT rejects protected path: ${mount_path}"
					errors=1
					;;
			esac
			if [[ ! -e "${mount_path}" ]]; then
				echo "${_CLR_RED}  ✗${_CLR_RESET} EXTRA_BIND_MOUNT path does not exist: ${mount_path}"
				errors=1
			fi
		done
	fi

	ccache_file="${TARBALL_FOLDER}/ccache.tbz2"
	sccache_file="${TARBALL_FOLDER}/sccache.tbz2"

	[[ "${errors}" -eq 0 ]] || displayError "Configuration validation failed"
}

# -----------------------------------------------------------------------------
# Lock
# -----------------------------------------------------------------------------

# @brief Create /tmp/.<basename>.lock with noclobber. Sets _did_lock for the trap.
do_lock() {
	if [[ "${DRY_RUN}" == "1" ]]; then
		log "  [dry-run] would set lockfile ${lockfile}"
		return 0
	fi
	printStep "Setting lockfile"
	if ! (set -o noclobber; : > "${lockfile}") 2>/dev/null; then
		printFail
		printf "\n  ${_CLR_BOLD_RED}Another instance is already running.${_CLR_RESET}\n"
		printf "  Lockfile: ${_CLR_CYAN}%s${_CLR_RESET}\n" "${lockfile}"
		printf "  ${_CLR_DIM}If this is an error, manually delete the lockfile.${_CLR_RESET}\n\n"
		exit "${E_RUNTIME}"
	fi
	_did_lock=1
	printOK
}

# @brief Remove the stage lock. Trap also does this if _did_lock is set.
do_unlock() {
	if [[ "${DRY_RUN}" == "1" ]]; then
		return 0
	fi
	handleCommand "rm -f ${lockfile}" "Removing lockfile"
	_did_lock=0
}

# -----------------------------------------------------------------------------
# Temporary storage (use / rebase / download only — not convert/export)
# -----------------------------------------------------------------------------

# @brief mktemp -d for the stage tree or download scratch. Sets _did_tmp.
create_tmp_folder() {
	if [[ "${DRY_RUN}" == "1" ]]; then
		tmp_folder="/tmp/dry-run-stage-manager"
		log "  [dry-run] tmp_folder=${tmp_folder}"
		return 0
	fi
	printStep "Creating temporary folder"
	tmp_folder="$(mktemp -d -t "tmp.${tarball_filename:-stage}.XXXXXXXX")" \
		|| { printFail; displayError "Failed to create temporary folder"; }
	_did_tmp=1
	printOK
	printf "  ${_CLR_DIM}%s${_CLR_RESET}\n" "${tmp_folder}"
}

# @brief Remove the tmp directory if it is no longer a mountpoint.
delete_tmp_folder() {
	[[ -z "${tmp_folder:-}" ]] && return 0
	if [[ "${DRY_RUN}" == "1" ]]; then
		return 0
	fi
	if mountpoint -q "${tmp_folder}" 2>/dev/null; then
		warn "tmp tree still mounted — not removing ${tmp_folder}"
		return 0
	fi
	handleCommand "rm -Rf ${tmp_folder}" "Deleting temporary folder"
	tmp_folder=""
	_did_tmp=0
}

# @brief STORAGE_SYSTEM=folder: tmp dir is already the tree.
mount_folder() { mkdir -p "${tmp_folder}"; }

# @brief Allocate a zram device, ext2, mount on tmp_folder. Fallback tmpfs.
# @note Sets _did_zram only when this PID actually holds a device.
mount_zram() {
	mkdir -p "${tmp_folder}"
	zram_device_full="$(zramctl -f 2>/dev/null || true)"
	zram_device="$(basename "${zram_device_full:-}")"
	if [[ -z "${zram_device}" ]]; then
		warn "No free ZRAM device — falling back to tmpfs"
		STORAGE_SYSTEM="tmpfs"
		mount_tmpfs
		return 0
	fi
	_did_zram=1
	handleCommand "echo 1 > /sys/block/${zram_device}/reset" "Resetting ZRAM ${zram_device}"
	if [[ -n "${STORAGE_SYSTEM_ZRAM_COMPRESSION_ALGO:-}" ]]; then
		handleCommand "printf '%s\n' '${STORAGE_SYSTEM_ZRAM_COMPRESSION_ALGO}' > /sys/block/${zram_device}/comp_algorithm" \
			"ZRAM compression ${STORAGE_SYSTEM_ZRAM_COMPRESSION_ALGO}"
	fi
	handleCommand "echo '${STORAGE_SIZE}' > /sys/block/${zram_device}/disksize" "ZRAM size ${STORAGE_SIZE}"
	handleCommand "mkfs.ext2 -F -q ${zram_device_full}" "Creating ext2 on ZRAM"
	handleCommand "mount -t ext2 -o noatime,nodiratime,discard ${zram_device_full} '${tmp_folder}'" "Mounting ZRAM"
}

# @brief Mount tmpfs of STORAGE_SIZE on tmp_folder.
mount_tmpfs() {
	mkdir -p "${tmp_folder}"
	handleCommand "mount -t tmpfs -o size=${STORAGE_SIZE} tmpfs ${tmp_folder}" "Mounting tmpfs"
}

# @brief STORAGE_SYSTEM=folder: just cd back; tree lives in tmp_folder.
unmount_folder() { cd "${current_folder}"; }

# @brief Umount + reset the zram this PID allocated.
unmount_zram() {
	cd "${current_folder}"
	[[ -z "${tmp_folder:-}" ]] && return 0
	handleCommand "umount -Rl ${tmp_folder}" "Unmounting ZRAM"
	handleCommand "rm -Rf ${tmp_folder}" "Clearing ZRAM mountpoint data"
	handleCommand "sync" "Flushing"
	if [[ "${_did_zram}" -eq 1 && -n "${zram_device:-}" ]]; then
		handleCommand "echo 1 > /sys/block/${zram_device}/reset" "Deactivating ${zram_device}"
		_did_zram=0
	fi
}

# @brief Umount the tmpfs on tmp_folder.
unmount_tmpfs() {
	cd "${current_folder}"
	handleCommand "umount -R ${tmp_folder}" "Unmounting tmpfs"
}

# @brief Dispatch mount by STORAGE_SYSTEM. convert/export must not call this.
mount_temp() {
	case "${STORAGE_SYSTEM}" in
		folder) mount_folder ;;
		tmpfs)  mount_tmpfs ;;
		zram)   mount_zram ;;
	esac
}

# @brief Dispatch unmount by STORAGE_SYSTEM.
unmount_temp() {
	case "${STORAGE_SYSTEM}" in
		folder) unmount_folder ;;
		tmpfs)  unmount_tmpfs ;;
		zram)   unmount_zram ;;
	esac
}

# @brief Remount the stage tree read-only before packing (use/rebase/convert-old).
readonly_temp() {
	if [[ "${STORAGE_SYSTEM}" != "folder" ]]; then
		handleCommand "mount -o remount,ro ${tmp_folder}" "Making stage filesystem readonly"
	fi
}

# @brief Pack the extracted tree to output_folder/tarball_output (use/rebase save).
# @note Writes .name.compress then mv. Trap deletes the partial. After mv,
#       remember_artifact so sudo callers get SUDO_UID ownership.
compress_archive() {
	phase_start
	cd "${tmp_folder}"
	_partial_path="${output_folder}/.${tarball_output}.compress"
	handleCommandWithOutput "${tar_compress} | pv -s \$(du -sbl ${tmp_folder} | awk '{print \$1}') | ${compress} > ${_partial_path}" \
		"Compressing to ${tarball_output}"
	mv "${_partial_path}" "${output_folder}/${tarball_output}"
	_partial_path=""
	remember_artifact "${output_folder}/${tarball_output}"
	phase_end "Compress"
}

# @brief Prompt and pack the stage tarball. Optional $1 = new full path (rebase).
# @param $1 Optional destination full path. Must not exist yet; codec comes
#           from that name's extension. Does not require the dest file.
# @note FILE caches are packed by cache_release regardless of the answer.
save_changes() {
	if [[ "${DRY_RUN}" == "1" ]]; then
		log "  [dry-run] would prompt to save changes"
		return 0
	fi
	if ! confirm_yes "Save changes?"; then
		readonly_temp
		printf "  ${_CLR_DIM}No stage changes saved"
		if [[ "${USE_CCACHE_FILE}" == "YES" || "${USE_SCCACHE_FILE:-NO}" == "YES" ]]; then
			printf " (compiler caches still persist in FILE mode)"
		fi
		printf ".${_CLR_RESET}\n"
		return 0
	fi
	if [[ "$#" -ge 1 && -n "${1:-}" ]]; then
		output_folder="$(dirname "$1")"
		tarball_output="$(basename "$1")"
		set_compression_from_name "${tarball_output}"
	else
		output_folder="${TARBALL_FOLDER}"
		tarball_output="${tarball}"
		set_codec_from_extension "${tarball_extension}"
	fi
	readonly_temp
	compress_archive
}

# @brief use: lock, extract, chroot, optional save. Requires root (sudo -E).
cmd_use() {
	require_root
	set_and_check_file
	check_free_space
	if [[ "${DRY_RUN}" == "1" ]]; then
		info "Stage" "${tarball}"
		info "Storage" "${STORAGE_SYSTEM} ${STORAGE_SIZE:-}"
		log "  [dry-run] would lock, extract, mount, chroot, save, unlock"
		return 0
	fi
	do_lock
	create_tmp_folder
	mount_temp
	extract_archive
	mount_pkg
	mount_distfiles
	mount_repos
	mount_gentoo_patches
	mount_extra_bind_mounts
	prepare_cache
	unpack_cache
	mount_system
	do_chroot
	show_ccache_stats
	show_sccache_stats
	stop_sccache_server
	unmount_system
	unprepare_cache
	unmount_extra_bind_mounts
	unmount_gentoo_patches
	unmount_repos
	unmount_distfiles
	unmount_pkg
	clean_stage
	save_changes
	cache_release
	if [[ -f "${ccache_file}" ]]; then remember_artifact "${ccache_file}"; fi
	if [[ -f "${sccache_file}" ]]; then remember_artifact "${sccache_file}"; fi
	chown_owned_artifacts
	unmount_temp
	delete_tmp_folder
	do_unlock
}

# @brief rebase: same as use, save target is parameters[2] (need not exist).
cmd_rebase() {
	require_root
	[[ -n "${parameters[2]:-}" ]] || usage_error "Missing new filename" \
		"${SCRIPT_NAME} rebase <index|file> <new_file_name>"
	set_and_check_file
	check_free_space
	if [[ "${DRY_RUN}" == "1" ]]; then
		log "  [dry-run] would rebase ${tarball} → ${parameters[2]}"
		return 0
	fi
	do_lock
	create_tmp_folder
	mount_temp
	extract_archive
	mount_pkg
	mount_distfiles
	mount_repos
	mount_gentoo_patches
	mount_extra_bind_mounts
	prepare_cache
	unpack_cache
	mount_system
	do_chroot
	show_ccache_stats
	show_sccache_stats
	stop_sccache_server
	unmount_system
	unprepare_cache
	unmount_extra_bind_mounts
	unmount_gentoo_patches
	unmount_repos
	unmount_distfiles
	unmount_pkg
	clean_stage
	save_changes "${TARBALL_FOLDER}/$(basename "${parameters[2]}")"
	cache_release
	if [[ -f "${ccache_file}" ]]; then remember_artifact "${ccache_file}"; fi
	if [[ -f "${sccache_file}" ]]; then remember_artifact "${sccache_file}"; fi
	chown_owned_artifacts
	unmount_temp
	delete_tmp_folder
	do_unlock
}

# @brief convert: stream recompress next to the source. No root, no STORAGE_*.
cmd_convert() {
	[[ -n "${parameters[2]:-}" ]] || usage_error "Missing compression format" \
		"${SCRIPT_NAME} convert <index|file> <gzip|bzip2|xz|zstd>"
	set_and_check_file
	set_compression "${parameters[2]}"
	recompress_stage \
		"${tarball_filename_fullpath}" \
		"${TARBALL_FOLDER}/${tarball_output}" \
		"${tarball_format}"
}

# @brief export: convert fold, always xz, <stem>-YYYYMMDD.txz in dest folder.
cmd_export() {
	[[ -n "${parameters[2]:-}" ]] || usage_error "Missing dest folder" \
		"${SCRIPT_NAME} export <index|file> <dest_folder>"
	set_and_check_file
	output_folder="${parameters[2]}"
	[[ -d "${output_folder}" ]] || displayError "Destination folder does not exist: ${output_folder}"
	tarball_output="${tarball_filename}-$(date +%Y%m%d).txz"
	recompress_stage \
		"${tarball_filename_fullpath}" \
		"${output_folder}/${tarball_output}" \
		"xz"
}

