# @brief Parse command, print header, validate conf, dispatch.
main() {
	if [[ "${1:-}" == "--version" || "${1:-}" == "-V" ]]; then
		printf '%s %s\n' "${SCRIPT_NAME}" "${STORMBYTE_STAGEMANAGER_VERSION}"
		exit "${E_OK}"
	fi

	if [[ $# -gt 0 ]]; then
		parameters=("$@")
	fi

	display_header
	check_vars
	set_output_folder
	refresh_file_list
	require_pv

	local command="${parameters[0]:-}"
	case "${command}" in
		ls) command="list" ;;
		rm) command="delete" ;;
	esac

	case "${command}" in
		list)     cmd_list ;;
		use)      cmd_use ;;
		convert)  cmd_convert ;;
		export)   cmd_export ;;
		delete)   cmd_delete ;;
		rename)   cmd_rename ;;
		rebase)   cmd_rebase ;;
		download) cmd_download ;;
		help)     cmd_help ;;
		notes)    cmd_notes ;;
		config)   cmd_config ;;
		"")
			display_usage
			exit "${E_OK}"
			;;
		*)
			display_usage
			exit "${E_USAGE}"
			;;
	esac
	exit "${E_OK}"
}

main "$@"
