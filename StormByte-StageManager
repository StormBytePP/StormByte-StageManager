# -----------------------------------------------------------------------------
# Emergency cleanup (EXIT / INT / TERM / HUP) — idempotent
# -----------------------------------------------------------------------------
emergency_cleanup() {
	[[ "${_cleanup_done}" -eq 1 ]] && return 0
	_cleanup_done=1
	trap - EXIT INT TERM HUP

	cd "${current_folder}" 2>/dev/null || true

	# sccache keeps files open on the cache dir — stop before any umount
	stop_sccache_server 2>/dev/null || true

	# Drop stage-side cache binds before wiping the stage tree
	if [[ -n "${tmp_folder:-}" ]]; then
		if [[ -n "${CCACHE_DIR:-}" ]] && mountpoint -q "${tmp_folder}${CCACHE_DIR}" 2>/dev/null; then
			umount "${tmp_folder}${CCACHE_DIR}" 2>/dev/null || umount -l "${tmp_folder}${CCACHE_DIR}" 2>/dev/null || true
		fi
		if [[ -n "${SCCACHE_DIR:-}" ]] && mountpoint -q "${tmp_folder}${SCCACHE_DIR}" 2>/dev/null; then
			umount "${tmp_folder}${SCCACHE_DIR}" 2>/dev/null || umount -l "${tmp_folder}${SCCACHE_DIR}" 2>/dev/null || true
		fi
	fi

	# Last FILE holder packs sidecars (independent of stage save)
	cache_release 2>/dev/null || true

	if [[ -n "${tmp_folder:-}" && -d "${tmp_folder}" ]]; then
		umount -Rl "${tmp_folder}" 2>/dev/null || true
		rm -Rf "${tmp_folder}" 2>/dev/null || true
		tmp_folder=""
	fi
	if [[ "${STORAGE_SYSTEM:-}" == "zram" && -n "${zram_device:-}" ]]; then
		sync 2>/dev/null || true
		echo 1 > "/sys/block/${zram_device}/reset" 2>/dev/null || true
	fi
	if [[ -n "${output_folder:-}" && -n "${tarball_output:-}" ]]; then
		rm -f "${output_folder}/.${tarball_output}.compress" 2>/dev/null || true
	fi
	if [[ -n "${lockfile:-}" && -f "${lockfile}" ]]; then
		rm -f "${lockfile}" 2>/dev/null || true
	fi
}

trap emergency_cleanup EXIT INT TERM HUP

