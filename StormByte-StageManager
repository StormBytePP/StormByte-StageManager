# @brief Start a wall-clock timer for a multi-step phase.
phase_start() {
	_phase_t0="$(date +%s)"
}

# @brief End the current phase and print elapsed seconds.
# @param $1 Short label.
phase_end() {
	local now label="${1:-done}"
	now="$(date +%s)"
	local elapsed=$((now - _phase_t0))
	printf "  ${_CLR_BOLD_GREEN}✓ OK${_CLR_RESET} ${_CLR_DIM}│${_CLR_RESET} %s (%ss)\n" "${label}" "${elapsed}"
}

# @brief Abort unless pv is on PATH (extract / stream / download progress).
require_pv() {
	require_cmd pv
}

# @brief Warn if free space under a path looks smaller than STORAGE_SIZE (or 5G).
# @param $1 Directory to measure (default TARBALL_FOLDER).
check_free_space() {
	local target="${1:-${TARBALL_FOLDER}}"
	local avail_kb
	avail_kb="$(df -Pk "${target}" 2>/dev/null | awk 'NR==2 {print $4}')"
	[[ -z "${avail_kb}" ]] && return 0
	local need_kb=5242880
	if [[ "${STORAGE_SIZE}" =~ ^([0-9]+)G$ ]]; then
		need_kb=$(( ${BASH_REMATCH[1]} * 1024 * 1024 ))
	elif [[ "${STORAGE_SIZE}" =~ ^([0-9]+)M$ ]]; then
		need_kb=$(( ${BASH_REMATCH[1]} * 1024 ))
	fi
	if [[ "${avail_kb}" -lt "${need_kb}" ]]; then
		warn "Low free space on ${target}: ${avail_kb} KiB available (want ~${need_kb} KiB)"
	fi
}

