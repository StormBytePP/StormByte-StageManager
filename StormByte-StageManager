extract_archive() {
	local text
	if [[ "$#" -eq 0 ]]; then
		text="Extracting ${tarball}"
	else
		text="Rebasing $(basename "$1") from ${tarball}"
	fi
	phase_start
	cd "${tmp_folder}"
	handleCommandWithOutput "pv ${tarball_filename_fullpath} | ${extract} | ${tar_decompress}" "${text}"
	phase_end "Extract"
}

compress_archive() {
	phase_start
	cd "${tmp_folder}"
	handleCommandWithOutput "${tar_compress} | pv -s \$(du -sbl ${tmp_folder} | awk '{print \$1}') | ${compress} > ${output_folder}/.${tarball_output}.compress" \
		"Compressing to ${tarball_output}"
	mv "${output_folder}/.${tarball_output}.compress" "${output_folder}/${tarball_output}"
	phase_end "Compress"
}

# FILE unpack is performed inside cache_file_acquire_one
unpack_cache() {
	[[ "${SKIP_CACHE}" == "1" ]] && warn "SKIP_CACHE=1 — shared FILE acquire skipped in prepare_cache"
	return 0
}

# FILE pack is only via cache_release (last holder), never tied to stage save
save_cache() {
	return 0
}

# Do not wipe shared workspace contents
clean_caches() {
	return 0
}

stop_sccache_server() {
	[[ "${USE_SCCACHE:-NO}" == "YES" ]] || return 0
	# Prefer stopping from inside the stage while the tree is still mounted
	if [[ -n "${tmp_folder:-}" && -x "${tmp_folder}/usr/bin/sccache" ]]; then
		handleCommand "chroot \"${tmp_folder}\" /usr/bin/env SCCACHE_DIR=\"${SCCACHE_DIR}\" su - portage -s /bin/bash -c '/usr/bin/sccache --stop-server' || chroot \"${tmp_folder}\" /usr/bin/env SCCACHE_DIR=\"${SCCACHE_DIR}\" /usr/bin/sccache --stop-server || true" \
			"Stopping sccache server" || true
	fi
	# Also try host binary against shared workspace (FILE mode) / host dir (BIND)
	if command -v sccache >/dev/null 2>&1; then
		local dir="${SCCACHE_DIR}"
		[[ "${USE_SCCACHE_FILE}" == "YES" ]] && dir="${SCCACHE_SHARE_ROOT}"
		SCCACHE_DIR="${dir}" sccache --stop-server 2>/dev/null || true
	fi
}

show_ccache_stats() {
	[[ "${USE_CCACHE}" != "YES" ]] && return 0
	if [[ -n "${tmp_folder:-}" && -x "${tmp_folder}/usr/bin/ccache" ]]; then
		section "ccache statistics"
		chroot "${tmp_folder}" /usr/bin/env "CCACHE_DIR=${CCACHE_DIR}" \
			/usr/bin/ccache -s 2>/dev/null || true
		printf '\n'
	fi
}

show_sccache_stats() {
	[[ "${USE_SCCACHE:-NO}" != "YES" ]] && return 0
	local sccache_bin=""
	local env_dir="${SCCACHE_DIR}"

	# Prefer stage binary while tree is still mounted
	if [[ -n "${tmp_folder:-}" && -x "${tmp_folder}/usr/bin/sccache" ]]; then
		section "sccache statistics"
		chroot "${tmp_folder}" /usr/bin/env \
			"SCCACHE_DIR=${SCCACHE_DIR}" \
			"SCCACHE_CACHE_SIZE=${SCCACHE_CACHE_SIZE:-20G}" \
			/usr/bin/sccache --show-stats 2>/dev/null || true
		printf '\n'
		return 0
	fi

	# Fallback: host binary (FILE mode share root if needed)
	if command -v sccache >/dev/null 2>&1; then
		[[ "${USE_SCCACHE_FILE}" == "YES" ]] && env_dir="${SCCACHE_SHARE_ROOT}"
		section "sccache statistics"
		SCCACHE_DIR="${env_dir}" sccache --show-stats 2>/dev/null || true
		printf '\n'
	fi
}

clean_stage() {
	handleCommand "rm -Rf ${tmp_folder}/tmp/* ${tmp_folder}/var/tmp/portage" "Cleaning portage temp"
	printStep "Cleaning package and distfile caches"
	rm -Rf "${tmp_folder}${PKG_DIR}/"* "${tmp_folder}${DISTFILES_DIR}/"* > /dev/null 2>&1 || true
	printOK
	handleCommand "find ${tmp_folder}/var/log -type f -exec rm -f {} \; && find ${tmp_folder}/var/tmp -type f -exec rm -f {} \;" "Cleaning logs" || true
	handleCommand "rm -f ${tmp_folder}/root/.bash_history" "Cleaning history" || true
}

save_changes() {
	# Stage tarball only. Compiler caches (FILE mode) are handled by cache_release
	# and are saved even when the user declines persisting stage changes.
	if [[ "${DRY_RUN}" == "1" ]]; then
		log "  [dry-run] would prompt to save changes"
		return 0
	fi
	if ! confirm_yes "Save changes?"; then
		readonly_temp
		printf "  ${_CLR_DIM}No stage changes saved"
		if [[ "${USE_CCACHE_FILE}" == "YES" || "${USE_SCCACHE_FILE:-NO}" == "YES" ]]; then
			printf " (compiler caches still persist in FILE mode)"
		fi
		printf ".${_CLR_RESET}\n"
		return 0
	fi
	if [[ "$#" -ne 0 ]]; then
		set_and_check_file "${TARBALL_FOLDER}/${parameters[2]}"
	fi
	readonly_temp
	compress_archive
	if [[ "$#" -ne 0 ]]; then
		# restore selection context for unlock lockfile name consistency
		set_and_check_file
	fi
}

do_chroot() {
	if [[ "${DRY_RUN}" == "1" ]]; then
		log "  [dry-run] would enter chroot ${tmp_folder}"
		return 0
	fi
	printf '\n'
	printf "  ${_CLR_BOLD_CYAN}┌────────────────────────────────────────────────────┐${_CLR_RESET}\n"
	printf "  ${_CLR_BOLD_CYAN}│${_CLR_RESET}  ${_CLR_BOLD_WHITE}Entering chroot environment${_CLR_RESET}                       ${_CLR_BOLD_CYAN}│${_CLR_RESET}\n"
	printf "  ${_CLR_BOLD_CYAN}│${_CLR_RESET}  ${_CLR_DIM}Don't forget: env-update && . /etc/profile${_CLR_RESET}        ${_CLR_BOLD_CYAN}│${_CLR_RESET}\n"
	if [[ "${USE_CCACHE}" == "YES" ]]; then
		printf "  ${_CLR_BOLD_CYAN}│${_CLR_RESET}  ${_CLR_DIM}ccache:  CCACHE_DIR=%s  FEATURES+=ccache%s${_CLR_RESET}\n" \
			"${CCACHE_DIR}" \
			"${CCACHE_CACHE_SIZE:+  maxsize=${CCACHE_CACHE_SIZE}}"
	fi
	if [[ "${USE_SCCACHE:-NO}" == "YES" ]]; then
		printf "  ${_CLR_BOLD_CYAN}│${_CLR_RESET}  ${_CLR_DIM}sccache: SCCACHE_DIR=%s  size=%s${_CLR_RESET}\n" \
			"${SCCACHE_DIR}" "${SCCACHE_CACHE_SIZE:-20G}"
		printf "  ${_CLR_BOLD_CYAN}│${_CLR_RESET}  ${_CLR_DIM}         RUSTC_WRAPPER=/usr/bin/sccache${_CLR_RESET}\n"
	fi
	printf "  ${_CLR_BOLD_CYAN}└────────────────────────────────────────────────────┘${_CLR_RESET}\n"
	printf '\n'

	if [[ "${USE_CCACHE}" != "YES" && "${USE_SCCACHE:-NO}" != "YES" ]]; then
		chroot "${tmp_folder}" /bin/bash -i
		return 0
	fi

	# Transparent env only — nothing written into the stage tree
	local -a env_args=()
	local setup=""
	local sccache_size="${SCCACHE_CACHE_SIZE:-20G}"

	if [[ "${USE_CCACHE}" == "YES" ]]; then
		env_args+=( "CCACHE_DIR=${CCACHE_DIR}" )
		# Config name is CCACHE_CACHE_SIZE; ccache expects CCACHE_MAXSIZE
		[[ -n "${CCACHE_CACHE_SIZE:-}" ]] && env_args+=( "CCACHE_MAXSIZE=${CCACHE_CACHE_SIZE}" )
		setup+='export FEATURES="${FEATURES:+${FEATURES} }ccache"; '
	fi

	if [[ "${USE_SCCACHE:-NO}" == "YES" ]]; then
		env_args+=(
			"SCCACHE_DIR=${SCCACHE_DIR}"
			"SCCACHE_CACHE_SIZE=${sccache_size}"
			"SCCACHE_IDLE_TIMEOUT=0"
			"SCCACHE_MAX_FRAME_LENGTH=104857600"
			"RUSTC_WRAPPER=/usr/bin/sccache"
		)
		# Start server as portage (same user Portage uses under userpriv)
		setup+='if [[ -x /usr/bin/sccache ]]; then
	su - portage -s /bin/bash -c "SCCACHE_DIR=\"'"${SCCACHE_DIR}"'\" SCCACHE_CACHE_SIZE=\"'"${sccache_size}"'\" SCCACHE_IDLE_TIMEOUT=0 SCCACHE_MAX_FRAME_LENGTH=104857600 /usr/bin/sccache --start-server" 2>/dev/null || true
fi; '
	fi

	setup+='exec /bin/bash -i'

	chroot "${tmp_folder}" /usr/bin/env "${env_args[@]}" \
		/bin/bash -c "${setup}"
}

# -----------------------------------------------------------------------------
