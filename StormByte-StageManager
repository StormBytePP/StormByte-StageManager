	create_tmp_folder
	mount_temp
	extract_archive
	readonly_temp
	compress_archive
	unmount_temp
	delete_tmp_folder
	do_unlock
}

cmd_delete() {
	set_and_check_file
	if [[ "${DRY_RUN}" == "1" ]]; then
		log "  [dry-run] would delete ${tarball}"
		return 0
	fi
	confirm_yes "Delete ${tarball}?" || { printf "  ${_CLR_DIM}Aborted.${_CLR_RESET}\n"; exit "${E_OK}"; }
	do_lock
	handleCommand "rm -f '${tarball_filename_fullpath}'" "Deleting ${tarball}"
	rm -f "${tarball_filename_fullpath}.notes" 2>/dev/null || true
	do_unlock
}

cmd_rename() {
	[[ -n "${parameters[2]:-}" ]] || usage_error "Missing new name" \
		"${SCRIPT_NAME} rename <index|file> <new_file_name>"
	local new_filename
	new_filename="$(basename "${parameters[2]}")"
	set_and_check_file
	check_file_copy "${tarball_filename_fullpath}" "${new_filename}"
	if [[ "${DRY_RUN}" == "1" ]]; then
		log "  [dry-run] would rename ${tarball} → ${new_filename}"
		return 0
	fi
	do_lock
	handleCommand "mv '${tarball_filename_fullpath}' '${TARBALL_FOLDER}/${new_filename}'" \
		"Renaming ${tarball} → ${new_filename}"
	if [[ -f "${tarball_filename_fullpath}.notes" ]]; then
		mv "${tarball_filename_fullpath}.notes" "${TARBALL_FOLDER}/${new_filename}.notes" 2>/dev/null || true
	fi
	do_unlock
}

cmd_download() {
	check_download_parameters
	if [[ "${DRY_RUN}" == "1" ]]; then
		log "  [dry-run] would download arch=${arch} profile=${profile} (${stage_info_file})"
		return 0
	fi
	create_tmp_folder
	printStep "Downloading stage information"
	if ! curl_retry -o "${tmp_folder}/${stage_info_file}" "${stage_base_url}/${stage_info_file}"; then
		printFail
		delete_tmp_folder
		displayError "Failed to download stage info"
	fi
	printOK
	if [[ ! -s "${tmp_folder}/${stage_info_file}" ]]; then
		delete_tmp_folder
		displayError "Empty stage info file"
	fi
	stage_file="$(grep -m1 '^[^#].*\.tar\.xz' "${tmp_folder}/${stage_info_file}" | awk '{print $1}')"
	if [[ -z "${stage_file}" ]]; then
		delete_tmp_folder
		displayError "Could not parse stage path from info file"
	fi
	if [[ ! "${stage_file}" =~ ^[a-zA-Z0-9/_.-]+\.tar\.xz$ ]]; then
		delete_tmp_folder
		displayError "Unexpected characters in stage path: ${stage_file}"
	fi
	local stage_basename
	stage_basename="$(basename "${stage_file}")"
	phase_start
	printf "  ${_CLR_BOLD_CYAN}◆${_CLR_RESET} ${_CLR_WHITE}Downloading %s${_CLR_RESET} ${_CLR_DIM}…${_CLR_RESET}\n" "${stage_basename}"
	if ! curl_retry -o "${tmp_folder}/${stage_basename}" "${stage_base_url}/${stage_file}"; then
		printf "  ${_CLR_BOLD_RED}✗ FAIL${_CLR_RESET}\n"
		delete_tmp_folder
		displayError "Failed to download ${stage_basename}"
	fi
	phase_end "Download"

	printStep "Fetching DIGESTS"
	if curl_retry --silent -o "${tmp_folder}/${stage_basename}.DIGESTS" \
			"${stage_base_url}/${stage_file}.DIGESTS" 2>/dev/null; then
		printOK
		printStep "Verifying integrity"
		local hash_line hash_algo
		hash_line="$(grep -E "^[0-9a-fA-F]{128}[[:space:]]+${stage_basename}$" \
			"${tmp_folder}/${stage_basename}.DIGESTS" 2>/dev/null | head -1)"
		if [[ -z "${hash_line}" ]]; then
			hash_line="$(grep -E "^[0-9a-fA-F]{64}[[:space:]]+${stage_basename}$" \
				"${tmp_folder}/${stage_basename}.DIGESTS" 2>/dev/null | head -1)"
		fi
		if [[ -n "${hash_line}" ]]; then
			if [[ "${hash_line}" =~ ^[0-9a-fA-F]{128}[[:space:]] ]]; then
				hash_algo="sha512sum"
			else
				hash_algo="sha256sum"
			fi
			if ( cd "${tmp_folder}" && echo "${hash_line}" | ${hash_algo} -c --status 2>/dev/null ); then
				printOK
			else
				printFail
				rm -f "${tmp_folder}/${stage_basename}" "${tmp_folder}/${stage_basename}.DIGESTS"
				delete_tmp_folder
				displayError "Integrity check failed for ${stage_basename}"
			fi
		else
			printSkip "no matching hash line"
		fi
		rm -f "${tmp_folder}/${stage_basename}.DIGESTS"
	else
		printSkip "DIGESTS not available"
	fi

	handleCommand "mv '${tmp_folder}/${stage_basename}' '${TARBALL_FOLDER}/${stage_basename}'" \
		"Installing stage into ${TARBALL_FOLDER}"
	delete_tmp_folder
	ok "${stage_basename} → ${TARBALL_FOLDER}"
}

cmd_notes() {
	# notes list  |  notes <sel> edit|delete
	if [[ "${parameters[1]:-}" == "list" ]]; then
		section "Stages with notes"
		local f base found=0
		for f in "${TARBALL_FOLDER}"/*.notes; do
			[[ -e "${f}" ]] || continue
			base="$(basename "${f}" .notes)"
			printf "  ${_CLR_BOLD_GREEN}•${_CLR_RESET} %s\n" "${base}"
			found=1
		done
		[[ "${found}" -eq 1 ]] || printf "  ${_CLR_DIM}(none)${_CLR_RESET}\n"
		printf '\n'
		return 0
	fi
	[[ -n "${parameters[1]:-}" && -n "${parameters[2]:-}" ]] || usage_error "Missing arguments" \
		"${SCRIPT_NAME} notes list | ${SCRIPT_NAME} notes <sel> edit|delete"
	set_and_check_file "${parameters[1]}"
	local notes_file="${tarball_filename_fullpath}.notes"
	case "${parameters[2]}" in
		edit)
			if [[ "${DETACH_NOTE_EDITOR}" == "YES" ]]; then
				${TARBALL_NOTE_EDITOR} "${notes_file}" &
			else
				${TARBALL_NOTE_EDITOR} "${notes_file}"
			fi
			;;
		delete)
			if [[ -f "${notes_file}" ]]; then
				confirm_yes "Delete notes for ${tarball}?" || return 0
				rm -f "${notes_file}"
				ok "Notes deleted"
			else
				warn "No notes for ${tarball}"
			fi
			;;
		*)
			usage_error "Unrecognized notes subcommand" \
				"${SCRIPT_NAME} notes list | ${SCRIPT_NAME} notes <sel> edit|delete"
			;;
	esac
}

cmd_config() {
	section "Resolved configuration"
	info "Version"        "${STORMBYTE_STAGEMANAGER_VERSION}"
	info "Functions"      "${STORMBYTE_FUNCTIONS_VERSION} (require ≥ ${REQUIRE_STORMBYTE_FUNCTIONS})"
	info "TARBALL_FOLDER" "${TARBALL_FOLDER}"
	info "STORAGE"        "${STORAGE_SYSTEM} ${STORAGE_SIZE:-} ${STORAGE_SYSTEM_ZRAM_COMPRESSION_ALGO:-}"
	info "Editor"         "${TARBALL_NOTE_EDITOR} (detach=${DETACH_NOTE_EDITOR})"
	info "USE_CCACHE"     "${USE_CCACHE} bind=${USE_CCACHE_BIND} file=${USE_CCACHE_FILE} dir=${CCACHE_DIR:-} size=${CCACHE_CACHE_SIZE:-(default)} tmpfs=${CCACHE_TMPFS_SIZE:-${STORAGE_SIZE:-8G}}"
	info "USE_SCCACHE"    "${USE_SCCACHE:-NO} bind=${USE_SCCACHE_BIND:-NO} file=${USE_SCCACHE_FILE:-NO} dir=${SCCACHE_DIR:-} size=${SCCACHE_CACHE_SIZE:-20G} tmpfs=${SCCACHE_TMPFS_SIZE:-${STORAGE_SIZE:-8G}}"
	info "PKG_DIR"        "${PKG_DIR} bind=${USE_PKG_BIND}"
	info "DISTFILES"      "${DISTFILES_DIR} bind=${USE_DISTFILES_BIND}"
	info "REPOS"          "${REPOS_DIR} bind=${USE_REPOS_BIND}"
	info "PATCHES_BIND"   "${USE_GENTOO_PATCHES_BIND}"
	info "EXTRA_BIND"     "${EXTRA_BIND_MOUNT:-(none)}"
	info "Compression"    "gzip=${GZIP_COMPRESSION_LEVEL} bzip=${BZIP_COMPRESSION_LEVEL} xz=${XZ_COMPRESSION_LEVEL} zstd=${ZSTD_COMPRESSION_LEVEL}"
	info "DRY_RUN"        "${DRY_RUN}"
	info "FORCE"          "${FORCE}"
	info "SKIP_CACHE"     "${SKIP_CACHE}"
	info "pv"             "$(command -v pv || echo missing)"
	printf '\n'
}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------
main() {
	# --version before header noise
	if [[ "${1:-}" == "--version" || "${1:-}" == "-V" ]]; then
		printf '%s %s\n' "${SCRIPT_NAME}" "${STORMBYTE_STAGEMANAGER_VERSION}"
		exit "${E_OK}"
	fi

	# Re-bind parameters if main received args (functions.sh already set parameters from $0)
	if [[ $# -gt 0 ]]; then
		parameters=("$@")
	fi

	display_header
	check_vars
	set_output_folder
	refresh_file_list
	require_pv

	local command="${parameters[0]:-}"
	# aliases
	case "${command}" in
		ls) command="list" ;;
		rm) command="delete" ;;
	esac

	case "${command}" in
		list)     cmd_list ;;
		use)      cmd_use ;;
		convert)  cmd_convert ;;
		export)   cmd_export ;;
		delete)   cmd_delete ;;
		rename)   cmd_rename ;;
		rebase)   cmd_rebase ;;
		download) cmd_download ;;
		help)     cmd_help ;;
		notes)    cmd_notes ;;
		config)   cmd_config ;;
		"")
			display_usage
			exit "${E_OK}"
			;;
		*)
			display_usage
			exit "${E_USAGE}"
			;;
	esac
	exit "${E_OK}"
}

main "$@"