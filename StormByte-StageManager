# @brief Resolve arch/profile to Gentoo latest-stage3-*.txt on GENTOO_BASE_URL.
check_download_parameters() {
	arch="${parameters[1]:-}"
	profile="${parameters[2]:-default}"
	local profile_error=0 arch_error=0
	[[ -n "${arch}" ]] || usage_error "Missing arch" "${SCRIPT_NAME} download <arch> [profile]"

	case "${arch}" in
		i486)
			stage_base_url="${GENTOO_BASE_URL}/x86/autobuilds"
			case "${profile}" in
				default) stage_info_file="latest-stage3-i486-openrc.txt" ;;
				*) profile_error=1 ;;
			esac
			;;
		i686)
			stage_base_url="${GENTOO_BASE_URL}/x86/autobuilds"
			case "${profile}" in
				default)         stage_info_file="latest-stage3-i686-openrc.txt" ;;
				hardened)        stage_info_file="latest-stage3-i686-hardened-openrc.txt" ;;
				systemd)         stage_info_file="latest-stage3-i686-systemd.txt" ;;
				uclibc-hardened) stage_info_file="latest-stage3-i686-uclibc-hardened.txt" ;;
				uclibc-vanilla)  stage_info_file="latest-stage3-i686-uclibc-vanilla.txt" ;;
				*) profile_error=1 ;;
			esac
			;;
		amd64)
			stage_base_url="${GENTOO_BASE_URL}/amd64/autobuilds"
			case "${profile}" in
				default)                      stage_info_file="latest-stage3-amd64-openrc.txt" ;;
				hardened)                     stage_info_file="latest-stage3-amd64-hardened-openrc.txt" ;;
				nomultilib)                   stage_info_file="latest-stage3-amd64-nomultilib-openrc.txt" ;;
				systemd)                      stage_info_file="latest-stage3-amd64-systemd.txt" ;;
				hardened+nomultilib)          stage_info_file="latest-stage3-amd64-hardened+nomultilib-openrc.txt" ;;
				hardened-selinux)             stage_info_file="latest-stage3-amd64-hardened-selinux-openrc.txt" ;;
				hardened-selinux+nomultilib)  stage_info_file="latest-stage3-amd64-hardened-selinux+nomultilib-openrc.txt" ;;
				uclibc-hardened)              stage_info_file="latest-stage3-amd64-uclibc-hardened.txt" ;;
				uclibc-vanilla)               stage_info_file="latest-stage3-amd64-uclibc-vanilla.txt" ;;
				*) profile_error=1 ;;
			esac
			;;
		x32)
			stage_base_url="${GENTOO_BASE_URL}/amd64/autobuilds"
			case "${profile}" in
				default) stage_info_file="latest-stage3-x32-openrc.txt" ;;
				*) profile_error=1 ;;
			esac
			;;
		*) arch_error=1 ;;
	esac
	[[ "${arch_error}" -eq 0 ]] || displayError "Unsupported arch '${arch}'"
	[[ "${profile_error}" -eq 0 ]] || displayError "Profile '${profile}' not available for '${arch}'"
}

# @brief curl --fail --location with 3 outer attempts. To be moved to functions.sh.
curl_retry() {
	local attempt=1
	while [[ "${attempt}" -le 3 ]]; do
		if curl --fail --location --retry 0 "$@"; then
			return 0
		fi
		warn "Download attempt ${attempt}/3 failed — retrying in 5s"
		sleep 5
		attempt=$((attempt + 1))
	done
	return 1
}

