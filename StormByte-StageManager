#!/usr/bin/env bash
# =============================================================================
# StormByte-StageManager — Gentoo stage tarball manager for chroot operations
# =============================================================================
# Manages Gentoo chroot environments from compressed tarballs (list, use,
# rebase, convert, export, delete, rename, download, notes).
#
# Config: /etc/conf.d/StormByte-StageManager.conf  (or alongside this script)
# Author: David C. Manuelda a.k.a StormByte <StormByte@gmail.com>
# =============================================================================
set -o pipefail

