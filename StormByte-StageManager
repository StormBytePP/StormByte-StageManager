}

# -----------------------------------------------------------------------------
# Shared FILE cache (tmpfs workspace + refcount; last session packs .tbz2)
# -----------------------------------------------------------------------------
_cache_lock_path()    { printf '%s/%s.lock' "${CACHE_LOCK_DIR}" "$1"; }
_cache_holders_path() { printf '%s/%s.holders' "${CACHE_LOCK_DIR}" "$1"; }
_cache_ref_path()     { printf '%s/%s.ref' "${CACHE_LOCK_DIR}" "$1"; }

# $1=name  $2=share_root  $3=tbz2  $4=tmpfs_size  $5=stage_mountpoint
cache_file_acquire_one() {
	local name="$1" root="$2" tbz2="$3" sz="$4" stage_mp="$5"
	local lockf holdf refh live pid tmp

	[[ "${SKIP_CACHE}" == "1" || "${DRY_RUN}" == "1" ]] && return 0

	lockf="$(_cache_lock_path "${name}")"
	holdf="$(_cache_holders_path "${name}")"
	refh="$(_cache_ref_path "${name}")"

	mkdir -p "${CACHE_LOCK_DIR}"
	exec 9>"${lockf}"
	flock 9

	live=0
	tmp="$(mktemp)"
	if [[ -f "${holdf}" ]]; then
		while IFS= read -r pid || [[ -n "${pid}" ]]; do
			[[ -z "${pid}" ]] && continue
			if kill -0 "${pid}" 2>/dev/null; then
				echo "${pid}" >> "${tmp}"
				live=$((live + 1))
			fi
		done < "${holdf}"
	fi
	mv -f "${tmp}" "${holdf}"

	if [[ "${live}" -eq 0 ]]; then
		mkdir -p "${root}"
		if ! mountpoint -q "${root}" 2>/dev/null; then
			handleCommand "mount -t tmpfs -o size=${sz} tmpfs ${root}" \
				"Shared ${name} tmpfs at ${root} (${sz})"
		fi
		if [[ -f "${tbz2}" ]]; then
			find "${root}" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true
			printf "  ${_CLR_BOLD_CYAN}◆${_CLR_RESET} ${_CLR_WHITE}Unpacking %s into shared workspace${_CLR_RESET} ${_CLR_DIM}…${_CLR_RESET}\n" "${name}"
			if ( cd "${root}" && pv "${tbz2}" | ${bzip2} -d - | ${tar_decompress} ); then
				printf "  ${_CLR_BOLD_GREEN}✓ OK${_CLR_RESET}\n"
			else
				printf "  ${_CLR_BOLD_RED}✗ FAIL${_CLR_RESET}\n"
				warn "${name} unpack failed — continuing with empty workspace"
			fi
		fi
	else
		info "${name}" "joining shared workspace (${live} session(s) already active)"
	fi

	echo "$$" >> "${holdf}"
	live=$((live + 1))
	echo "${live}" > "${refh}"

	flock -u 9
	exec 9>&-

	mkdir -p "${stage_mp}"
	handleCommand "mount --bind ${root} ${stage_mp}" "Binding shared ${name} → stage"

	case "${name}" in
		ccache)  _ccache_holder=1 ;;
		sccache) _sccache_holder=1 ;;
	esac
}

# $1=name  $2=share_root  $3=tbz2
cache_file_release_one() {
	local name="$1" root="$2" tbz2="$3"
	local lockf holdf refh live pid tmp partial

	lockf="$(_cache_lock_path "${name}")"
	holdf="$(_cache_holders_path "${name}")"
	refh="$(_cache_ref_path "${name}")"

	mkdir -p "${CACHE_LOCK_DIR}"
	exec 9>"${lockf}"
	flock 9

	tmp="$(mktemp)"
	if [[ -f "${holdf}" ]]; then
		while IFS= read -r pid || [[ -n "${pid}" ]]; do
			[[ -z "${pid}" || "${pid}" == "$$" ]] && continue
			if kill -0 "${pid}" 2>/dev/null; then
				echo "${pid}" >> "${tmp}"
			fi
		done < "${holdf}"
	fi
	mv -f "${tmp}" "${holdf}"

	live=0
	if [[ -f "${holdf}" && -s "${holdf}" ]]; then
		live="$(wc -l < "${holdf}" | tr -d ' ')"
	fi
	echo "${live}" > "${refh}"

	if [[ "${live}" -eq 0 ]]; then
		if mountpoint -q "${root}" 2>/dev/null; then
			partial="${tbz2}.partial"
			printf "  ${_CLR_BOLD_CYAN}◆${_CLR_RESET} ${_CLR_WHITE}Packing shared %s → %s${_CLR_RESET} ${_CLR_DIM}…${_CLR_RESET}\n" \
				"${name}" "$(basename "${tbz2}")"
			if ( cd "${root}" && ${tar_compress} \
				| pv -s "$(du -sbl . | awk '{print $1}')" \
				| ${bzip2} > "${partial}" ); then
				mv -f "${partial}" "${tbz2}"
				printf "  ${_CLR_BOLD_GREEN}✓ OK${_CLR_RESET}\n"
			else
				rm -f "${partial}"
				printf "  ${_CLR_BOLD_RED}✗ FAIL${_CLR_RESET}\n"
				warn "${name} pack failed — shared workspace left mounted for inspection"
				flock -u 9
				exec 9>&-
				return 1
			fi
			umount "${root}" 2>/dev/null || umount -l "${root}" 2>/dev/null || true
		fi
		rm -f "${holdf}" "${refh}" 2>/dev/null || true
		# Last session: remove empty share root so /tmp does not keep leftovers
		if [[ -d "${root}" ]] && ! mountpoint -q "${root}" 2>/dev/null; then
			# Best-effort: only if empty (no stray files)
			rmdir "${root}" 2>/dev/null \
				|| rm -rf "${root}" 2>/dev/null \
				|| true
		fi
	else
		info "${name}" "still in use by ${live} session(s) — skip pack"
	fi

	flock -u 9
	exec 9>&-
	return 0
}

# Idempotent. Safe under trap and normal exit.
cache_release() {
	[[ "${_cache_released}" -eq 1 ]] && return 0
	_cache_released=1
	[[ "${SKIP_CACHE}" == "1" || "${DRY_RUN}" == "1" ]] && return 0

	# sccache first: server must already be stopped (caller/trap responsibility)
	if [[ "${_sccache_holder}" -eq 1 ]]; then
		cache_file_release_one "sccache" "${SCCACHE_SHARE_ROOT}" "${sccache_file}" || true
		_sccache_holder=0
	fi
	if [[ "${_ccache_holder}" -eq 1 ]]; then
		cache_file_release_one "ccache" "${CCACHE_SHARE_ROOT}" "${ccache_file}" || true
		_ccache_holder=0
	fi

	# If no holders remain for either cache, drop empty lock directory
	if [[ ! -e "$(_cache_holders_path ccache)" \
		&& ! -e "$(_cache_holders_path sccache)" \
		&& ! -e "$(_cache_ref_path ccache)" \
		&& ! -e "$(_cache_ref_path sccache)" ]]; then
		rm -f \
			"$(_cache_lock_path ccache)" \
			"$(_cache_lock_path sccache)" \
			2>/dev/null || true
		rmdir "${CACHE_LOCK_DIR}" 2>/dev/null || true
	fi
}

prepare_cache() {
	if [[ "${USE_CCACHE}" == "YES" ]]; then
		mkdir -p "${tmp_folder}${CCACHE_DIR}"
		touch "${tmp_folder}${CCACHE_DIR}/.keep"
		if [[ "${USE_CCACHE_BIND}" == "YES" ]]; then
			handleCommand "mount --bind ${CCACHE_DIR} ${tmp_folder}${CCACHE_DIR}" "Mounting ccache (host bind)"
		elif [[ "${USE_CCACHE_FILE}" == "YES" ]]; then
			cache_file_acquire_one "ccache" "${CCACHE_SHARE_ROOT}" "${ccache_file}" \
				"${CCACHE_TMPFS_SIZE}" "${tmp_folder}${CCACHE_DIR}"
			chroot "${tmp_folder}" chown -R portage:portage "${CCACHE_DIR}" 2>/dev/null || true
			chmod -R 770 "${tmp_folder}${CCACHE_DIR}" 2>/dev/null || true
		fi
	fi
	if [[ "${USE_SCCACHE:-NO}" == "YES" ]]; then
		mkdir -p "${tmp_folder}${SCCACHE_DIR}"
		touch "${tmp_folder}${SCCACHE_DIR}/.keep"
		if [[ "${USE_SCCACHE_BIND}" == "YES" ]]; then
			handleCommand "mount --bind ${SCCACHE_DIR} ${tmp_folder}${SCCACHE_DIR}" "Mounting sccache (host bind)"
		elif [[ "${USE_SCCACHE_FILE}" == "YES" ]]; then
			cache_file_acquire_one "sccache" "${SCCACHE_SHARE_ROOT}" "${sccache_file}" \
				"${SCCACHE_TMPFS_SIZE}" "${tmp_folder}${SCCACHE_DIR}"
			chroot "${tmp_folder}" chown -R portage:portage "${SCCACHE_DIR}" 2>/dev/null || true
			chmod -R 770 "${tmp_folder}${SCCACHE_DIR}" 2>/dev/null || true
		fi
	fi
}

unprepare_cache() {
	cd "${current_folder}" 2>/dev/null || true
	# Unmount stage-side binds only; shared tmpfs stays until last cache_release
	if [[ "${USE_CCACHE}" == "YES" ]]; then
		if mountpoint -q "${tmp_folder}${CCACHE_DIR}" 2>/dev/null; then
			handleCommand "umount ${tmp_folder}${CCACHE_DIR}" "Unmounting ccache from stage" || true
		fi
	fi
	if [[ "${USE_SCCACHE:-NO}" == "YES" ]]; then
		if mountpoint -q "${tmp_folder}${SCCACHE_DIR}" 2>/dev/null; then
			handleCommand "umount ${tmp_folder}${SCCACHE_DIR}" "Unmounting sccache from stage" || true
		fi
	fi
}

mount_system() {
	handleCommand "mount -t proc /proc ${tmp_folder}/proc && mount --rbind /dev ${tmp_folder}/dev && mount --make-rslave ${tmp_folder}/dev && mount --rbind /sys ${tmp_folder}/sys && mount --make-rslave ${tmp_folder}/sys && mount --rbind /run ${tmp_folder}/run && mount --make-rslave ${tmp_folder}/run" \
		"Mounting system structures"
}

unmount_system() {
	cd "${current_folder}"
	handleCommand "umount -Rl ${tmp_folder}/proc && umount -Rl ${tmp_folder}/dev && umount -Rl ${tmp_folder}/sys && umount -l ${tmp_folder}/run" \
		"Unmounting system structures"
}

