fi

require_version "${STORMBYTE_FUNCTIONS_VERSION}" "${REQUIRE_STORMBYTE_FUNCTIONS}" "StormByte functions"

# functions.sh sets: workdir, self, parameters, current_dir
current_folder="${current_folder:-$(pwd)}"

loadConfig

