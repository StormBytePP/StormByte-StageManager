# -----------------------------------------------------------------------------
# Emergency cleanup
# -----------------------------------------------------------------------------

# @brief Unmount path if it is a mountpoint. Best-effort; never aborts the trap.
# @param $1 Absolute path that may be mounted.
# @note To be moved to functions.sh (generic umount helper).
_umount_path() {
	local p="$1"
	[[ -n "${p}" ]] || return 0
	mountpoint -q "${p}" 2>/dev/null || return 0
	umount "${p}" 2>/dev/null || umount -l "${p}" 2>/dev/null || true
}

# @brief Idempotent EXIT/INT/TERM/HUP handler for this process only.
# @note Drops stage binds, releases FILE-cache holders (last packer), umounts
#       the tmp tree, resets zram iff this PID created it and the mount is
#       gone, deletes a stream .partial, then drops the stage lock.
#       Does not rm -rf a directory that is still a mountpoint.
#       list/help/config leave every inventory flag at 0 so this is a no-op.
emergency_cleanup() {
	[[ "${_cleanup_done}" -eq 1 ]] && return 0
	_cleanup_done=1
	trap - EXIT INT TERM HUP

	cd "${current_folder}" 2>/dev/null || true

	stop_sccache_server 2>/dev/null || true

	if [[ -n "${tmp_folder:-}" ]]; then
		_umount_path "${tmp_folder}${CCACHE_DIR:-}"
		_umount_path "${tmp_folder}${SCCACHE_DIR:-}"
		_umount_path "${tmp_folder}${PKG_DIR:-}"
		_umount_path "${tmp_folder}${DISTFILES_DIR:-}"
		_umount_path "${tmp_folder}${REPOS_DIR:-}"
		_umount_path "${tmp_folder}/etc/portage/patches"
		if [[ -n "${EXTRA_BIND_MOUNT:-}" ]]; then
			local saved_ifs="${IFS}" mount_path
			IFS=';' read -ra extra_mounts <<< "${EXTRA_BIND_MOUNT}"
			IFS="${saved_ifs}"
			for mount_path in "${extra_mounts[@]}"; do
				[[ -z "${mount_path}" ]] && continue
				_umount_path "${tmp_folder}${mount_path}"
			done
		fi
		_umount_path "${tmp_folder}/proc"
		_umount_path "${tmp_folder}/dev"
		_umount_path "${tmp_folder}/sys"
		_umount_path "${tmp_folder}/run"
	fi

	cache_release 2>/dev/null || true

	if [[ "${_did_tmp}" -eq 1 && -n "${tmp_folder:-}" && -d "${tmp_folder}" ]]; then
		if mountpoint -q "${tmp_folder}" 2>/dev/null; then
			umount -Rl "${tmp_folder}" 2>/dev/null || umount -l "${tmp_folder}" 2>/dev/null || true
		fi
		if mountpoint -q "${tmp_folder}" 2>/dev/null; then
			warn "tmp tree still mounted — not removing ${tmp_folder}"
		else
			rm -Rf "${tmp_folder}" 2>/dev/null || true
			tmp_folder=""
			_did_tmp=0
		fi
	fi

	if [[ "${_did_zram}" -eq 1 && -n "${zram_device:-}" ]]; then
		if [[ -n "${tmp_folder:-}" ]] && mountpoint -q "${tmp_folder}" 2>/dev/null; then
			warn "zram still busy — skip reset of ${zram_device}"
		else
			sync 2>/dev/null || true
			echo 1 > "/sys/block/${zram_device}/reset" 2>/dev/null || true
			_did_zram=0
		fi
	fi

	if [[ -n "${_partial_path:-}" && -e "${_partial_path}" ]]; then
		rm -f "${_partial_path}" 2>/dev/null || true
		_partial_path=""
	fi
	if [[ -n "${output_folder:-}" && -n "${tarball_output:-}" ]]; then
		rm -f "${output_folder}/.${tarball_output}.compress" 2>/dev/null || true
	fi

	if [[ "${_did_lock}" -eq 1 && -n "${lockfile:-}" && -f "${lockfile}" ]]; then
		rm -f "${lockfile}" 2>/dev/null || true
		_did_lock=0
	fi
}

trap emergency_cleanup EXIT INT TERM HUP

# -----------------------------------------------------------------------------
# Privileges
# -----------------------------------------------------------------------------

# @brief Re-exec this script via sudo -E when use/rebase need mounts/chroot.
# @note Preserves DRY_RUN FORCE SKIP_CACHE TARBALL_FOLDER via -E.
#       Does not drop euid inside the chroot. Artifact ownership is restored
#       with SUDO_UID/SUDO_GID after writes.
require_root() {
	if [[ "${EUID}" -eq 0 ]]; then
		return 0
	fi
	if command -v sudo >/dev/null 2>&1; then
		info "Privileges" "re-exec via sudo -E"
		exec sudo -E -- "${BASH_SOURCE[0]}" "${parameters[@]}"
	fi
	displayError "needs root (chroot/mounts). Install sudo or run as root."
}

# @brief chown a path to the sudo caller when we were re-exec'd.
# @param $1 Path that this process just created or replaced.
chown_artifact() {
	local path="$1"
	[[ -n "${path}" && -e "${path}" ]] || return 0
	[[ -n "${SUDO_UID:-}" && -n "${SUDO_GID:-}" ]] || return 0
	chown "${SUDO_UID}:${SUDO_GID}" "${path}" 2>/dev/null || true
}

# @brief Remember a path written by this process and chown it if under sudo.
# @param $1 Path.
remember_artifact() {
	local path="$1"
	[[ -n "${path}" ]] || return 0
	_owned_artifacts+=("${path}")
	chown_artifact "${path}"
}

# @brief chown every remembered artifact (end of use/rebase).
chown_owned_artifacts() {
	local p
	for p in "${_owned_artifacts[@]+"${_owned_artifacts[@]}"}"; do
		chown_artifact "${p}"
	done
}

