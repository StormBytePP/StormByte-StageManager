# @brief Interactive chroot. Injects CCACHE_* / SCCACHE_* / FEATURES+=ccache in-env only.
do_chroot() {
	if [[ "${DRY_RUN}" == "1" ]]; then
		log "  [dry-run] would enter chroot ${tmp_folder}"
		return 0
	fi
	printf '\n'
	printf "  ${_CLR_BOLD_CYAN}┌────────────────────────────────────────────────────┐${_CLR_RESET}\n"
	printf "  ${_CLR_BOLD_CYAN}│${_CLR_RESET}  ${_CLR_BOLD_WHITE}Entering chroot environment${_CLR_RESET}                       ${_CLR_BOLD_CYAN}│${_CLR_RESET}\n"
	printf "  ${_CLR_BOLD_CYAN}│${_CLR_RESET}  ${_CLR_DIM}Don't forget: env-update && . /etc/profile${_CLR_RESET}        ${_CLR_BOLD_CYAN}│${_CLR_RESET}\n"
	if [[ "${USE_CCACHE}" == "YES" ]]; then
		printf "  ${_CLR_BOLD_CYAN}│${_CLR_RESET}  ${_CLR_DIM}ccache:  CCACHE_DIR=%s  FEATURES+=ccache%s${_CLR_RESET}\n" \
			"${CCACHE_DIR}" \
			"${CCACHE_CACHE_SIZE:+  maxsize=${CCACHE_CACHE_SIZE}}"
	fi
	if [[ "${USE_SCCACHE:-NO}" == "YES" ]]; then
		printf "  ${_CLR_BOLD_CYAN}│${_CLR_RESET}  ${_CLR_DIM}sccache: SCCACHE_DIR=%s  size=%s${_CLR_RESET}\n" \
			"${SCCACHE_DIR}" "${SCCACHE_CACHE_SIZE:-20G}"
		printf "  ${_CLR_BOLD_CYAN}│${_CLR_RESET}  ${_CLR_DIM}         RUSTC_WRAPPER=/usr/bin/sccache${_CLR_RESET}\n"
	fi
	printf "  ${_CLR_BOLD_CYAN}└────────────────────────────────────────────────────┘${_CLR_RESET}\n"
	printf '\n'

	if [[ "${USE_CCACHE}" != "YES" && "${USE_SCCACHE:-NO}" != "YES" ]]; then
		chroot "${tmp_folder}" /bin/bash -i
		return 0
	fi

	local -a env_args=()
	local setup=""
	local sccache_size="${SCCACHE_CACHE_SIZE:-20G}"

	if [[ "${USE_CCACHE}" == "YES" ]]; then
		env_args+=( "CCACHE_DIR=${CCACHE_DIR}" )
		[[ -n "${CCACHE_CACHE_SIZE:-}" ]] && env_args+=( "CCACHE_MAXSIZE=${CCACHE_CACHE_SIZE}" )
		setup+='export FEATURES="${FEATURES:+${FEATURES} }ccache"; '
	fi

	if [[ "${USE_SCCACHE:-NO}" == "YES" ]]; then
		env_args+=(
			"SCCACHE_DIR=${SCCACHE_DIR}"
			"SCCACHE_CACHE_SIZE=${sccache_size}"
			"SCCACHE_IDLE_TIMEOUT=0"
			"SCCACHE_MAX_FRAME_LENGTH=104857600"
			"RUSTC_WRAPPER=/usr/bin/sccache"
		)
		setup+='if [[ -x /usr/bin/sccache ]]; then
	su - portage -s /bin/bash -c "SCCACHE_DIR=\"'"${SCCACHE_DIR}"'\" SCCACHE_CACHE_SIZE=\"'"${sccache_size}"'\" SCCACHE_IDLE_TIMEOUT=0 SCCACHE_MAX_FRAME_LENGTH=104857600 /usr/bin/sccache --start-server" 2>/dev/null || true
fi; '
	fi

	setup+='exec /bin/bash -i'

	chroot "${tmp_folder}" /usr/bin/env "${env_args[@]}" \
		/bin/bash -c "${setup}"
}

