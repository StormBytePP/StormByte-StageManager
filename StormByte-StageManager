usage_error() {
	err "$1"
	[[ -n "${2:-}" ]] && printf "  ${_CLR_DIM}Accepted:${_CLR_RESET} %s\n" "$2"
	exit "${E_USAGE}"
}

phase_start() {
	# Timer only — step line is printed by handleCommand / handleCommandWithOutput
	_phase_t0="$(date +%s)"
}

phase_end() {
	local now label="${1:-done}"
	now="$(date +%s)"
	local elapsed=$((now - _phase_t0))
	printf "  ${_CLR_BOLD_GREEN}✓ OK${_CLR_RESET} ${_CLR_DIM}│${_CLR_RESET} %s (%ss)\n" "${label}" "${elapsed}"
}

require_pv() {
	if ! command -v pv >/dev/null 2>&1; then
		displayError "pv is required (declared as a package dependency)"
	fi
}

confirm_yes() {
	# $1 = prompt message. Returns 0 if yes. FORCE=1 skips prompt.
	local prompt="$1"
	if [[ "${FORCE}" == "1" ]]; then
		return 0
	fi
	local reply=""
	while [[ ! $reply =~ ^[YyNn]$ ]]; do
		printf "  ${_CLR_BOLD_YELLOW}%s${_CLR_RESET}  [${_CLR_BOLD_GREEN}Y${_CLR_RESET}/${_CLR_BOLD_RED}N${_CLR_RESET}]: " "${prompt}"
		read -r
		reply=$REPLY
	done
	[[ $reply =~ ^[Yy]$ ]]
}

check_free_space() {
	# Best-effort: warn if free space under TARBALL_FOLDER looks low (< STORAGE_SIZE or 5G)
	local target="${1:-${TARBALL_FOLDER}}"
	local avail_kb
	avail_kb="$(df -Pk "${target}" 2>/dev/null | awk 'NR==2 {print $4}')"
	[[ -z "${avail_kb}" ]] && return 0
	local need_kb=5242880 # 5 GiB default
	if [[ "${STORAGE_SIZE}" =~ ^([0-9]+)G$ ]]; then
		need_kb=$(( ${BASH_REMATCH[1]} * 1024 * 1024 ))
	elif [[ "${STORAGE_SIZE}" =~ ^([0-9]+)M$ ]]; then
		need_kb=$(( ${BASH_REMATCH[1]} * 1024 ))
	fi
	if [[ "${avail_kb}" -lt "${need_kb}" ]]; then
		warn "Low free space on ${target}: ${avail_kb} KiB available (want ~${need_kb} KiB)"
	fi
}

